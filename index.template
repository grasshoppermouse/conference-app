<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>HBES 2027</title>
        <meta name="theme-color" content="#18bc9c" />
        <link rel="manifest" href="manifest.json" />
        <link href="bootstrap.min.css" rel="stylesheet" />
        <link rel="stylesheet" href="bootstrap-icons.min.css" />
        <style>
            .fav-btn {
                cursor: pointer;
                padding: 0;
                margin-left: 8px;
                border: none;
                background: none;
                color: #ffc107;
                /* Bootstrap warning color for yellow/gold */
            }
            body {
                padding-bottom: 70px; /* Prevent content from being covered by the menubar */
            }

            .nav-item_active {
                color: #18bc9c !important; /* Match your theme color */
            }

            /* Highlight for active bottom nav items */
            .nav-link-btn.active-nav {
                color: #18bc9c !important; /* Your theme's teal color */
                font-weight: bold;
                transform: scale(1.1);
                transition: all 0.2s ease-in-out;
            }
            .pseudo-btn::before {
                content: attr(data-time);
            }
        </style>
    </head>

    <body class="pb-70">
        <!-- Main Content View -->
        <div id="app-main-content" class="container-fluid">
            <h3 class="mb-4">HBES 2027</h3>
            <ul class="nav nav-pills mb-3" id="pills-tab" role="tablist">
                {% for item in d -%}
                <li class="nav-item" role="presentation">
                    <button
                        class="nav-link"
                        id="pills-{{item.day}}-tab"
                        data-bs-toggle="pill"
                        data-bs-target="#pills-{{item.day}}"
                        type="button"
                        role="tab"
                        aria-controls="pills-{{item.day}}"
                        aria-selected="true"
                    >
                        {{item.day}}
                    </button>
                </li>
                {% endfor -%}
                <li class="nav-item ms-auto" role="presentation">
                    <button
                        class="nav-link"
                        id="pills-authors-tab"
                        data-bs-toggle="pill"
                        data-bs-target="#pills-authors"
                        type="button"
                        role="tab"
                        aria-controls="pills-authors"
                        aria-selected="false"
                    >
                        <i class="bi bi-person fs-4"></i>
                        <!--<div style="font-size: 10px">Authors</div>-->
                    </button>
                </li>
            </ul>

            <div class="tab-content" id="pills-tabContent">
                <!-- Schedule View -->
                {% for item in d -%}
                <div
                    class="tab-pane fade show"
                    id="pills-{{item.day}}"
                    role="tabpanel"
                    aria-labelledby="pills-{{item.day}}-tab"
                    tabindex="0"
                >
                    <div class="accordion" id="accordion{{item.day}}">
                        {% for session in item.data -%}
                        <div class="accordion-item">
                            <h2
                                class="accordion-header d-flex justify-content-between align-items-center"
                            >
                                <button
                                    class="accordion-button"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#collapse{{session.id}}"
                                    aria-expanded="true"
                                    aria-controls="collapse{{session.id}}"
                                >
                                    {{session.title}} <br />
                                    {{session.time}}. {{session.location}}
                                </button>
                                <button
                                    type="button"
                                    class="fav-btn"
                                    data-type="session"
                                    data-id="{{session.id}}"
                                    data-time="{{session.startdatetime}}"
                                    data-location="{{session.location}}"
                                    title="Favorite"
                                >
                                    <img src="./star.svg" alt="Favorite" />
                                </button>
                            </h2>
                            <div
                                id="collapse{{session.id}}"
                                class="accordion-collapse collapse"
                                data-bs-parent="#accordion{{item.day}}"
                            >
                                <div class="accordion-body">
                                    {% for talk in session.talk -%}
                                    <div class="d-flex align-items-center mb-2">
                                        <button
                                            type="button"
                                            class="btn btn-light text-start pseudo-btn"
                                            data-bs-toggle="modal"
                                            data-bs-target="#Modal{{talk.id}}"
                                            data-time="{{talk.start_time}}. "
                                        >
                                            {{talk.title}}
                                        </button>
                                        <button
                                            type="button"
                                            class="fav-btn"
                                            data-type="talk"
                                            data-id="{{talk.id}}"
                                            data-time="{{talk.startdatetime}}"
                                            data-location="{{talk.location}}"
                                            title="Favorite"
                                        >
                                            <img
                                                src="./star.svg"
                                                alt="Favorite"
                                            />
                                        </button>
                                    </div>
                                    {% endfor -%}
                                </div>
                            </div>
                        </div>
                        {% endfor -%}
                    </div>
                </div>
                {% endfor -%}

                <!-- Authors View -->
                <div
                    class="tab-pane fade"
                    id="pills-authors"
                    role="tabpanel"
                    aria-labelledby="pills-authors-tab"
                    tabindex="0"
                >
                    <div class="accordion" id="accordion-authors">
                        {% for author in authors -%}
                        <div class="accordion-item">
                            <h2
                                class="accordion-header d-flex justify-content-between align-items-center"
                            >
                                <button
                                    class="accordion-button"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#collapse{{author.author_id}}"
                                    aria-expanded="true"
                                    aria-controls="collapse{{author.author_id}}"
                                >
                                    {{author.data.0.author_name}}
                                </button>
                            </h2>
                            <div
                                id="collapse{{author.author_id}}"
                                class="accordion-collapse collapse"
                                data-bs-parent="#accordion-authors"
                            >
                                <div class="accordion-body">
                                    {% for talk in author.data -%}
                                    <div class="d-flex align-items-center mb-2">
                                        <a
                                            href="#"
                                            class="btn btn-light text-start"
                                            data-bs-toggle="modal"
                                            data-bs-target="#Modal{{talk.abstract}}"
                                        >
                                            {{talk.daytimelocation}}.
                                            <strong>{{talk.title}}</strong>
                                        </a>
                                        <button
                                            type="button"
                                            class="fav-btn"
                                            data-type="talk"
                                            data-id="{{talk.abstract}}"
                                            title="Favorite"
                                        >
                                            <img
                                                src="./star.svg"
                                                alt="Favorite"
                                            />
                                        </button>
                                    </div>
                                    {% endfor -%}
                                </div>
                            </div>
                        </div>
                        {% endfor -%}
                    </div>
                </div>
            </div>
        </div>

        <!-- View for Favorites -->
        <div id="app-favorites-view" style="display: none">
            <h3 class="mb-4">Favorites</h3>
            <div id="favorites-list"></div>
        </div>

        <!-- Bottom Navigation Bar -->
        <nav
            class="fixed-bottom bg-white border-top shadow-sm"
            style="height: 60px"
        >
            <div
                class="container d-flex justify-content-around align-items-center"
            >
                <a
                    href="#"
                    id="btn-nav-schedule"
                    class="text-decoration-none text-dark text-center nav-link-btn"
                >
                    <i class="bi bi-calendar3 fs-4"></i>
                    <div style="font-size: 10px">Schedule</div>
                </a>
                <a
                    href="#"
                    id="btn-nav-favorites"
                    class="text-decoration-none text-muted text-center nav-link-btn"
                >
                    <i class="bi bi-star fs-4"></i>
                    <div style="font-size: 10px">Favorites</div>
                </a>
            </div>
        </nav>

        <!-- Global Modals Container -->
        <div id="global-modals">
            {% for item in d -%} {% for session in item.data -%} {% for talk in
            session.talk -%}
            <div
                class="modal fade"
                id="Modal{{talk.id}}"
                tabindex="-1"
                aria-hidden="true"
            >
                <div class="modal-dialog modal-dialog-scrollable">
                    <div class="modal-content">
                        <div
                            class="modal-header d-flex justify-content-between align-items-center"
                        >
                            <h6 class="modal-title">{{talk.html_title}}</h6>
                            <button
                                type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close"
                            ></button>
                        </div>
                        <div class="modal-body">{{talk.abstract}}</div>
                        <div class="modal-footer">
                            <button
                                type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal"
                            >
                                Close
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            {% endfor -%} {% endfor -%} {% endfor -%}
        </div>

        <script src="bootstrap.bundle.min.js"></script>

        <script>
            // Helper function to handle active state toggling
            function setActiveNav(btnId) {
                const scheduleBtn = document.getElementById("btn-nav-schedule");
                const favsBtn = document.getElementById("btn-nav-favorites");

                // Remove active class from both
                if (scheduleBtn) scheduleBtn.classList.remove("active-nav");
                if (favsBtn) favsBtn.classList.remove("active-nav");

                // Add active class to the clicked one
                const activeBtn = document.getElementById(btnId);
                if (activeBtn) activeBtn.classList.add("active-nav");
            }

            document.addEventListener("DOMContentLoaded", () => {
                const favorites = JSON.parse(
                    localStorage.getItem("conference_favorites") || "{}",
                );
                const mainContent = document.getElementById("app-main-content");
                const favsZone = document.getElementById("app-favorites-view");

                function updateFavoriteIcons(type, id) {
                    const key = `${type}:${id}`;
                    const isFav = !!favorites[key];
                    const buttons = document.querySelectorAll(
                        `.fav-btn[data-type="${type}"][data-id="${id}"]`,
                    );
                    buttons.forEach((btn) => {
                        const img = btn.querySelector("img");
                        if (isFav) {
                            img.src = "./star-fill.svg";
                        } else {
                            img.src = "./star.svg";
                        }
                    });
                }

                // Initial render of favorite icons
                document.querySelectorAll(".fav-btn").forEach((btn) => {
                    updateFavoriteIcons(btn.dataset.type, btn.dataset.id);
                });

                // Favorite button click logic
                document.querySelectorAll(".fav-btn").forEach((btn) => {
                    btn.addEventListener("click", () => {
                        const id = btn.dataset.id;
                        const type = btn.dataset.type;
                        const key = `${type}:${id}`;

                        let labelText = "Favorite Item";
                        if (btn.parentElement.querySelector("button")) {
                            labelText =
                                btn.parentElement.querySelector(
                                    "button",
                                ).innerText;
                        } else if (btn.closest(".d-flex")) {
                            const otherBtn = btn
                                .closest(".d-flex")
                                .querySelector("button");
                            if (otherBtn) labelText = otherBtn.innerText;
                        }
                        labelText = labelText.split("\n")[0];
                        if (favorites[key]) {
                            delete favorites[key];
                        } else {
                            favorites[key] = {
                                title: labelText,
                                time: btn.dataset.time || "", // Ensure we grab the ISO string from data-time attribute
                                location: btn.dataset.location || "",
                                timestamp: new Date().toLocaleString(),
                            };
                        }

                        localStorage.setItem(
                            "conference_favorites",
                            JSON.stringify(favorites),
                        );
                        updateFavoriteIcons(type, id);
                    });
                });

                // Navigation Listeners
                document
                    .getElementById("btn-nav-schedule")
                    .addEventListener("click", (e) => {
                        e.preventDefault();
                        console.log("Navigating to Schedule");
                        if (mainContent) mainContent.style.display = "block";
                        if (favsZone) favsZone.style.display = "none";
                        setActiveNav("btn-nav-schedule");
                    });

                document
                    .getElementById("btn-nav-favorites")
                    .addEventListener("click", (e) => {
                        e.preventDefault();
                        console.log("Navigating to Favorites");
                        if (mainContent) mainContent.style.display = "none";
                        if (favsZone) favsZone.style.display = "block";
                        renderFavoritesList();
                        setActiveNav("btn-nav-favorites");
                    });

                function renderFavoritesList() {
                    const listContainer =
                        document.getElementById("favorites-list");
                    if (!listContainer) return;

                    const keys = Object.keys(favorites);
                    if (keys.length === 0) {
                        listContainer.innerHTML =
                            '<p class="text-muted">No favorites yet.</p>';
                        return;
                    }

                    // Map to objects and Sort by Date
                    let favItems = keys.map((key) => ({
                        key: key,
                        data: favorites[key],
                    }));

                    favItems.sort((a, b) => {
                        const dateA = new Date(a.data.time);
                        const dateB = new Date(b.data.time);
                        return dateA - dateB; // Sorts chronologically (earliest to latest)
                    });

                    listContainer.innerHTML = "";
                    favItems.forEach((item) => {
                        const data = item.data;
                        const div = document.createElement("div");
                        div.className = "card mb-3 shadow-sm";

                        let formattedTime = "";
                        if (data.time) {
                            const dateObj = new Date(data.time);
                            // Format to: Monday, Oct 25 - 10:30 AM
                            formattedTime =
                                dateObj.toLocaleDateString("en-US", {
                                    weekday: "long",
                                    month: "short",
                                    day: "numeric",
                                }) +
                                " - " +
                                dateObj.toLocaleTimeString("en-US", {
                                    hour: "2-digit",
                                    minute: "2-digit",
                                });
                        }

                        let content = `<h6 class="mb-1 text-primary">${data.title}</h6>`;
                        if (data.time) {
                            content += `<p class="mb-0 small"><i class="bi bi-calendar"></i> ${formattedTime}</p>`;
                        }
                        if (data.location) {
                            content += `<p class="mb-0 small"><i class="bi bi-geo-alt"></i> ${data.location}</p>`;
                        }

                        div.innerHTML = `<div class="card-body">${content}</div>`;
                        listContainer.appendChild(div);
                    });
                }

                // Set initial state on page load
                window.addEventListener("DOMContentLoaded", () => {
                    document
                        .getElementById("btn-nav-schedule")
                        .classList.add("active-nav");
                });
            });
        </script>
    </body>
</html>
