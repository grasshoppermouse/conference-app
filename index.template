<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>HBES 2027</title>
        <meta name="theme-color" content="#ecb73c" />
        <link rel="manifest" href="manifest.json" />
        <link href="bootstrap.min.css" rel="stylesheet" />
        <link rel="stylesheet" href="bootstrap-icons.min.css" />
        <style>
            .fav-btn {
                cursor: pointer;
                padding: 0;
                margin-left: 8px;
                border: none;
                background: none;
                color: #ffc107;
                /* Bootstrap warning color for yellow/gold */
            }
            body {
                padding-bottom: 70px; /* Prevent content from being covered by the menubar */
            }

            .nav-item_active {
                color: #ecb73c !important; /* Match your theme color */
            }

            /* Highlight for active bottom nav items */
            .nav-link-btn.active-nav {
                color: #ecb73c !important; /* Your theme's teal color */
                font-weight: bold;
                transform: scale(1.1);
                transition: all 0.2s ease-in-out;
            }
            .pseudo-btn::before {
                content: attr(data-time);
            }
        </style>
    </head>

    <body class="pb-70">
        <!-- Main Content View -->
        <div id="app-main-content" class="container-fluid">
            <h3 class="mb-4">HBES 2027</h3>
            <div class="mb-4">
                <div class="input-group mb-4">
                    <input
                        type="text"
                        id="search-input"
                        class="form-control form-control-lg"
                        placeholder="Search talks by title or abstract..."
                        autocomplete="off"
                    />
                    <button
                        class="btn btn-outline-secondary"
                        type="button"
                        id="clear-search"
                        onclick="
                            searchInput.value = '';
                            searchResults.innerHTML = '';
                            searchInput.dispatchEvent(new Event('input'));
                        "
                    >
                        <img src="./x.svg" alt="X" />
                    </button>
                </div>
                <div
                    id="search-results"
                    class="list-group mt-2"
                    style="max-height: 300px; overflow-y: auto"
                ></div>
            </div>
            <ul class="nav nav-pills mb-3" id="pills-tab" role="tablist">
                {% for item in d -%}
                <li class="nav-item" role="presentation">
                    <button
                        class="nav-link"
                        id="pills-{{item.day}}-tab"
                        data-bs-toggle="pill"
                        data-bs-target="#pills-{{item.day}}"
                        type="button"
                        role="tab"
                        aria-controls="pills-{{item.day}}"
                        aria-selected="true"
                    >
                        {{item.day}}
                    </button>
                </li>
                {% endfor -%}
                <li class="nav-item ms-auto" role="presentation">
                    <button
                        class="nav-link"
                        id="pills-authors-tab"
                        data-bs-toggle="pill"
                        data-bs-target="#pills-authors"
                        type="button"
                        role="tab"
                        aria-controls="pills-authors"
                        aria-selected="false"
                    >
                        <img src="./person.svg" alt="Person" />
                        <!--<div style="font-size: 10px">Authors</div>-->
                    </button>
                </li>
            </ul>

            <div class="tab-content" id="pills-tabContent">
                <!-- Schedule View -->
                {% for item in d -%}
                <div
                    class="tab-pane fade show"
                    id="pills-{{item.day}}"
                    role="tabpanel"
                    aria-labelledby="pills-{{item.day}}-tab"
                    tabindex="0"
                >
                    <div class="accordion" id="accordion{{item.day}}">
                        {% for session in item.data -%}
                        <div class="accordion-item">
                            <h2
                                class="accordion-header d-flex justify-content-between align-items-center"
                            >
                                <button
                                    class="accordion-button collapsed"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#collapse{{session.id}}"
                                    aria-expanded="false"
                                    aria-controls="collapse{{session.id}}"
                                >
                                    {{session.title}} <br />
                                    {{session.time}}. {{session.location}}
                                </button>
                                <button
                                    type="button"
                                    class="fav-btn"
                                    data-type="session"
                                    data-id="{{session.id}}"
                                    data-time="{{session.startdatetime}}"
                                    data-location="{{session.location}}"
                                    title="Favorite"
                                >
                                    <img src="./star.svg" alt="Favorite" />
                                </button>
                            </h2>
                            <div
                                id="collapse{{session.id}}"
                                class="accordion-collapse collapse"
                                data-bs-parent="#accordion{{item.day}}"
                            >
                                <div class="accordion-body">
                                    {% for talk in session.talk -%}
                                    <div class="d-flex align-items-center mb-2">
                                        <button
                                            type="button"
                                            class="btn btn-light text-start pseudo-btn"
                                            data-bs-toggle="modal"
                                            data-bs-target="#Modal{{talk.id}}"
                                            data-time="{{talk.start_time}}. "
                                        >
                                            {{talk.title}}
                                        </button>
                                        <button
                                            type="button"
                                            class="fav-btn"
                                            data-type="talk"
                                            data-id="{{talk.id}}"
                                            data-time="{{talk.startdatetime}}"
                                            data-location="{{talk.location}}"
                                            title="Favorite"
                                        >
                                            <img
                                                src="./star.svg"
                                                alt="Favorite"
                                            />
                                        </button>
                                    </div>
                                    {% endfor -%}
                                </div>
                            </div>
                        </div>
                        {% endfor -%}
                    </div>
                </div>
                {% endfor -%}

                <!-- Authors View -->
                <div
                    class="tab-pane fade"
                    id="pills-authors"
                    role="tabpanel"
                    aria-labelledby="pills-authors-tab"
                    tabindex="0"
                >
                    <div class="accordion" id="accordion-authors">
                        {% for author in authors -%}
                        <div
                            class="accordion-item"
                            data-id="{{author.author_id}}"
                            data-name="{{author.data.0.author_name}}"
                        >
                            <h2
                                class="accordion-header d-flex justify-content-between align-items-center"
                            >
                                <button
                                    class="accordion-button collapsed"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#collapse{{author.author_id}}"
                                    aria-expanded="false"
                                    aria-controls="collapse{{author.author_id}}"
                                >
                                    {{author.data.0.author_name}}
                                </button>
                            </h2>
                            <div
                                id="collapse{{author.author_id}}"
                                class="accordion-collapse collapse"
                                data-bs-parent="#accordion-authors"
                            >
                                <div class="accordion-body">
                                    {% for talk in author.data -%}
                                    <div class="d-flex align-items-center mb-2">
                                        <a
                                            href="#"
                                            class="btn btn-light text-start"
                                            data-bs-toggle="modal"
                                            data-bs-target="#Modal{{talk.abstract}}"
                                        >
                                            {{talk.daytimelocation}}.
                                            <strong>{{talk.title}}</strong>
                                        </a>
                                        <button
                                            type="button"
                                            class="fav-btn"
                                            data-type="talk"
                                            data-id="{{talk.abstract}}"
                                            data-time="{{talk.startdatetime}}"
                                            data-location="{{talk.location}}"
                                            data-title="{{talk.title}}"
                                            title="Favorite"
                                            alt="Favorite"
                                        >
                                            <img
                                                src="./star.svg"
                                                alt="Favorite"
                                            />
                                        </button>
                                    </div>
                                    {% endfor -%}
                                </div>
                            </div>
                        </div>
                        {% endfor -%}
                    </div>
                </div>
            </div>
        </div>

        <!-- View for Favorites -->
        <div id="app-favorites-view" style="display: none">
            <h3 class="mb-4" style="padding-left: 10px">Favorites</h3>
            <div id="favorites-list"></div>
        </div>

        <!-- Bottom Navigation Bar -->
        <nav
            class="fixed-bottom bg-white border-top shadow-sm"
            style="height: 60px"
        >
            <div
                class="container d-flex justify-content-around align-items-center"
            >
                <a
                    href="#"
                    id="btn-nav-schedule"
                    class="text-decoration-none text-dark text-center nav-link-btn"
                >
                    <img src="./calendar3.svg" class="fs-4" alt="Calendar" />
                    <div style="font-size: 10px">Schedule</div>
                </a>
                <a
                    href="#"
                    id="btn-nav-favorites"
                    class="text-decoration-none text-muted text-center nav-link-btn"
                >
                    <img src="./star.svg" class="fs-4" alt="Star" />
                    <div style="font-size: 10px">Favorites</div>
                </a>
            </div>
        </nav>

        <!-- Global Modals Container -->
        <div id="global-modals">
            {% for item in d -%} {% for session in item.data -%} {% for talk in
            session.talk -%}
            <div
                class="modal fade"
                id="Modal{{talk.id}}"
                tabindex="-1"
                aria-labelledby="Modal{{talk.id}}Label"
                aria-hidden="true"
            >
                <div class="modal-dialog modal-dialog-scrollable">
                    <div class="modal-content">
                        <div
                            class="modal-header d-flex justify-content-between align-items-center"
                        >
                            <!-- Title hidden as requested, but keeping a space for layout -->
                            <span
                                >{{talk.day}}, {{talk.start_time}}.
                                {{talk.location}}</span
                            >
                            <div class="d-flex align-items-center gap-3">
                                <!-- Favorite Button -->
                                <button
                                    type="button"
                                    class="fav-btn"
                                    data-type="talk"
                                    data-id="{{talk.id}}"
                                    data-time="{{talk.startdatetime}}"
                                    data-location="{{talk.location}}"
                                    data-title="{{talk.title}}"
                                    title="Favorite"
                                >
                                    <img src="./star.svg" alt="Favorite" />
                                </button>
                                <!-- Close Button -->
                                <button
                                    type="button"
                                    class="btn-close"
                                    data-bs-dismiss="modal"
                                    aria-label="Close"
                                ></button>
                            </div>
                        </div>
                        <div class="modal-body">{{talk.abstract}}</div>
                        <div class="modal-footer">
                            <button
                                type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal"
                            >
                                Close
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            {% endfor -%} {% endfor -%} {% endfor -%}
        </div>

        <script src="bootstrap.bundle.min.js"></script>

        <script>
            // Helper function to handle active state toggling
            function setActiveNav(btnId) {
                const scheduleBtn = document.getElementById("btn-nav-schedule");
                const favsBtn = document.getElementById("btn-nav-favorites");

                // Remove active class from both
                if (scheduleBtn) scheduleBtn.classList.remove("active-nav");
                if (favsBtn) favsBtn.classList.remove("active-nav");

                // Add active class to the clicked one
                const activeBtn = document.getElementById(btnId);
                if (activeBtn) activeBtn.classList.add("active-nav");
            }

            document.addEventListener("DOMContentLoaded", () => {
                const favorites = JSON.parse(
                    localStorage.getItem("conference_favorites") || "{}",
                );
                const mainContent = document.getElementById("app-main-content");
                const favsZone = document.getElementById("app-favorites-view");

                function updateFavoriteIcons(type, id) {
                    const key = `${type}:${id}`;
                    const isFav = !!favorites[key];
                    const buttons = document.querySelectorAll(
                        `.fav-btn[data-type="${type}"][data-id="${id}"]`,
                    );
                    buttons.forEach((btn) => {
                        const img = btn.querySelector("img");
                        if (isFav) {
                            img.src = "./star-fill.svg";
                        } else {
                            img.src = "./star.svg";
                        }
                    });
                }

                // Initial render of favorite icons
                document.querySelectorAll(".fav-btn").forEach((btn) => {
                    updateFavoriteIcons(btn.dataset.type, btn.dataset.id);
                });

                // Favorite button click logic
                document.querySelectorAll(".fav-btn").forEach((btn) => {
                    btn.addEventListener("click", () => {
                        const id = btn.dataset.id;
                        const type = btn.dataset.type;
                        const key = `${type}:${id}`;

                        let labelText = "Favorite Item";
                        if (btn.dataset.title) {
                            labelText = btn.dataset.title;
                        } else if (btn.parentElement.querySelector("button")) {
                            labelText =
                                btn.parentElement.querySelector(
                                    "button",
                                ).innerText;
                        } else if (btn.closest(".d-flex")) {
                            const otherBtn = btn
                                .closest(".d-flex")
                                .querySelector("button");
                            if (otherBtn) labelText = otherBtn.innerText;
                        }
                        labelText = labelText.split("\n")[0];
                        if (favorites[key]) {
                            delete favorites[key];
                        } else {
                            favorites[key] = {
                                title: labelText,
                                time: btn.dataset.time || "", // Ensure we grab the ISO string from data-time attribute
                                location: btn.dataset.location || "",
                                timestamp: new Date().toLocaleString(),
                            };
                        }

                        localStorage.setItem(
                            "conference_favorites",
                            JSON.stringify(favorites),
                        );
                        updateFavoriteIcons(type, id);
                    });
                });

                // Navigation Listeners
                document
                    .getElementById("btn-nav-schedule")
                    .addEventListener("click", (e) => {
                        e.preventDefault();
                        if (mainContent) mainContent.style.display = "block";
                        if (favsZone) favsZone.style.display = "none";
                        setActiveNav("btn-nav-schedule");
                    });

                document
                    .getElementById("btn-nav-favorites")
                    .addEventListener("click", (e) => {
                        e.preventDefault();
                        if (mainContent) mainContent.style.display = "none";
                        if (favsZone) favsZone.style.display = "block";
                        renderFavoritesList();
                        setActiveNav("btn-nav-favorites");
                    });

                function renderFavoritesList() {
                    const listContainer =
                        document.getElementById("favorites-list");
                    if (!listContainer) return;

                    const keys = Object.keys(favorites);
                    if (keys.length === 0) {
                        listContainer.innerHTML =
                            '<p class="text-muted">No favorites yet.</p>';
                        return;
                    }

                    // Map to objects and Sort by Date
                    let favItems = keys.map((key) => ({
                        key: key,
                        data: favorites[key],
                    }));

                    favItems.sort((a, b) => {
                        const dateA = new Date(a.data.time);
                        const dateB = new Date(b.data.time);
                        return dateA - dateB; // Sorts chronologically (earliest to latest)
                    });

                    listContainer.innerHTML = "";
                    favItems.forEach((item) => {
                        const [type, id] = item.key.split(":");
                        const data = item.data;
                        const div = document.createElement("div");
                        let content = ``;
                        div.className = "card rounded-0";
                        if (type === "talk") {
                            div.setAttribute("role", "button");
                            div.setAttribute("tabindex", "0"); // Allows keyboard focusing
                            div.setAttribute("data-bs-toggle", "modal");
                            div.setAttribute("data-bs-target", `#Modal${id}`);
                            content = `<h6 class="mb-1 text-primary">${data.title}</h6>`;
                        } else {
                            content = `<h6 class="mb-1 text-success">${data.title}</h6>`;
                        }

                        let formattedTime = "";
                        if (data.time) {
                            const dateObj = new Date(data.time);
                            // Format to: Monday, Oct 25 - 10:30 AM
                            formattedTime =
                                dateObj.toLocaleDateString("en-US", {
                                    weekday: "long",
                                    month: "short",
                                    day: "numeric",
                                }) +
                                " - " +
                                dateObj.toLocaleTimeString("en-US", {
                                    hour: "2-digit",
                                    minute: "2-digit",
                                });
                        }

                        if (data.time) {
                            content += `<p class="mb-0 small"><img src="./calendar.svg" alt="Calendar" /> ${formattedTime}</p>`;
                        }
                        if (data.location) {
                            content += `<p class="mb-0 small"><img src="./geo-alt.svg" alt="Location" /> ${data.location}</p>`;
                        }

                        div.innerHTML = `<div class="card-body">${content}</div>`;
                        listContainer.appendChild(div);
                    });
                }

                // Set initial state on page load
                window.addEventListener("DOMContentLoaded", () => {
                    document
                        .getElementById("btn-nav-schedule")
                        .classList.add("active-nav");
                });
            });

            // --- Search Functionality ---
            const searchInput = document.getElementById("search-input");
            const searchResults = document.getElementById("search-results");
            let talkIndex = [];
            let authorIndex = [];

            // 1. Build talkIndex on Load
            // Iterates through all modal elements generated by the template engine to build the search index
            document.addEventListener("DOMContentLoaded", () => {
                const modals = document.querySelectorAll(
                    "#global-modals .modal",
                );
                modals.forEach((modal) => {
                    const idMatch = modal.id.match(/Modal(\d+)/);
                    if (idMatch) {
                        const id = idMatch[1];
                        // Find the talk title from the modal content or headers if needed,
                        // but since we have buttons with titles and the structure is known:
                        const abstractText =
                            modal.querySelector(".modal-body").innerText;
                        // We can find the title by looking at the button that triggers this modal
                        // or searching for common patterns in the modal's initial structure
                        const titleElement =
                            modal.parentElement.previousElementSibling
                                ?.innerHTML || "";

                        // A more robust way is to look for the button that has a data-bs-target matching this modal's ID
                        const triggerBtn = document.querySelector(
                            `[data-bs-target="#Modal${id}"]`,
                        );
                        const title = triggerBtn
                            ? triggerBtn.innerText
                                  .replace(/\n/g, "")
                                  .split(". ")[0]
                            : "Untitled Talk";

                        talkIndex.push({
                            id: id,
                            title: title,
                            abstract: abstractText || "",
                        });
                    }
                });
            });

            // Build Author Index
            document.addEventListener("DOMContentLoaded", () => {
                const authors = document.querySelectorAll(
                    "#pills-authors .accordion-item",
                );

                authors.forEach((author) => {
                    authorIndex.push({
                        id: author.getAttribute("data-id"),
                        name:
                            author.getAttribute("data-name") ||
                            "Unknown Author",
                    });
                    // console.log(`Author ID found: ${author.author_id}`);
                });
            });

            // 1. Handle Input (Creates buttons with IDs embedded)
            searchInput.addEventListener("input", (e) => {
                const query = e.target.value.toLowerCase();
                searchResults.innerHTML = "";

                if (query.length < 2) return;

                const isAuthorsView = document
                    .getElementById("pills-authors")
                    ?.classList.contains("active");

                let results = [];
                if (isAuthorsView) {
                    results = authorIndex.filter((author) =>
                        author.name.toLowerCase().includes(query),
                    );
                } else {
                    results = talkIndex.filter(
                        (talk) =>
                            talk.title.toLowerCase().includes(query) ||
                            talk.abstract.toLowerCase().includes(query),
                    );
                }

                results.forEach((item) => {
                    const resultItem = document.createElement("button");
                    resultItem.className =
                        "list-group-item list-group-item-action d-flex justify-content-between align-items-center";

                    // IMPORTANT: We store the ID and Type directly on the element
                    // to avoid fragile string matching later.
                    resultItem.dataset.targetId = item.id;
                    resultItem.dataset.isAuthor = isAuthorsView
                        ? "true"
                        : "false";

                    const label = isAuthorsView ? item.name : item.title;
                    resultItem.innerHTML = `<span class="text-start">${label}</span>`;

                    searchResults.appendChild(resultItem);
                });
            });

            // 2. Handle Clicks (Delegation)
            if (searchResults) {
                searchResults.addEventListener("click", (e) => {
                    const btn = e.target.closest("button");
                    if (!btn || !searchResults.contains(btn)) return;

                    console.log("SEARCH CLICK DETECTED!");

                    const targetId = btn.dataset.targetId;
                    const isAuthor = btn.dataset.isAuthor === "true";

                    if (isAuthor) {
                        const element = document.getElementById(
                            `collapse${targetId}`,
                        );
                        if (element) {
                            // 1. Trigger the expansion
                            const bsCollapse =
                                bootstrap.Collapse.getOrCreateInstance(
                                    element,
                                    { toggle: true },
                                );
                            bsCollapse.toggle();

                            // 2. IMPORTANT: Wait for the animation to start/progress, then scroll
                            setTimeout(() => {
                                element.scrollIntoView({
                                    behavior: "smooth",
                                    block: "start", // Aligns the top of the accordion to the top of the viewport
                                });
                            }, 300); // 300ms matches Bootstrap's default transition speed
                        } else {
                            console.error(
                                `Element #collapse${targetId} not found.`,
                            );
                        }
                    } else {
                        // Standard Modal behavior for talks remains unchanged
                        btn.setAttribute("data-bs-toggle", "modal");
                        btn.setAttribute("data-bs-target", `#Modal${targetId}`);
                        btn.click();
                    }
                });
            }

            // Close results when clicking outside (optional but recommended)
            // document.addEventListener("click", (e) => {
            //     if (!searchInput.contains(e.target)) {
            //         searchResults.innerHTML = "";
            //     }
            // });
        </script>
    </body>
</html>
