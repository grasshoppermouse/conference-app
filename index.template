<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>HBES 2027</title>
        <meta name="theme-color" content="#ecb73c" />
        <link rel="manifest" href="manifest.json" />
        <link href="bootstrap.min.css" rel="stylesheet" />
        <link rel="stylesheet" href="bootstrap-icons.min.css" />
        <style>
            .fav-btn {
                cursor: pointer;
                padding: 0;
                margin-left: 8px;
                border: none;
                background: none;
                color: #ffc107;
                /* Bootstrap warning color for yellow/gold */
            }
            body {
                padding-bottom: 70px; /* Prevent content from being covered by the menubar */
            }

            .nav-item_active {
                color: #ecb73c !important; /* Match your theme color */
            }

            /* Highlight for active bottom nav items */
            .nav-link-btn.active-nav {
                color: #ecb73c !important; /* Your theme's teal color */
                font-weight: bold;
                transform: scale(1.1);
                transition: all 0.2s ease-in-out;
            }
            .pseudo-btn::before {
                content: attr(data-time);
            }
            .accordion-item {
                scroll-margin-top: 240px; /* Adjust this value to give it a nice cushion at the top */
            }
        </style>
    </head>

    <body class="pb-70">
        <!-- Main Content View -->
        <div id="app-main-content" class="container-fluid">
            <!-- START OF STICKY HEADER CONTAINER -->
            <div
                class="sticky-top bg-white pt-3 pb-2 mb-3 border-bottom"
                style="top: 0; z-index: 1020"
            >
                <h3 class="mb-3">HBES 2027</h3>
                <div class="mb-3">
                    <div class="input-group">
                        <input
                            type="text"
                            id="search-input"
                            class="form-control form-control-lg"
                            placeholder="Search talks by title or abstract..."
                            autocomplete="off"
                        />
                        <!-- FIXED: Removed inline onclick placeholder -->
                        <button
                            class="btn btn-outline-secondary"
                            type="button"
                            id="clear-search"
                        >
                            <img src="./x.svg" alt="X" />
                        </button>
                    </div>
                    <div
                        id="search-results"
                        class="list-group mt-2"
                        style="max-height: 300px; overflow-y: auto"
                    ></div>
                </div>
                <ul class="nav nav-pills mb-3" id="pills-tab" role="tablist">
                    {% for item in d -%}
                    <li class="nav-item" role="presentation">
                        <button
                            class="nav-link"
                            id="pills-{{item.day}}-tab"
                            data-bs-toggle="pill"
                            data-bs-target="#pills-{{item.day}}"
                            type="button"
                            role="tab"
                            aria-controls="pills-{{item.day}}"
                            aria-selected="true"
                        >
                            {{item.day}}
                        </button>
                    </li>
                    {% endfor -%}
                    <li class="nav-item ms-auto" role="presentation">
                        <button
                            class="nav-link"
                            id="pills-authors-tab"
                            data-bs-toggle="pill"
                            data-bs-target="#pills-authors"
                            type="button"
                            role="tab"
                            aria-controls="pills-authors"
                            aria-selected="false"
                        >
                            <img src="./person.svg" alt="Person" />
                        </button>
                    </li>
                </ul>
            </div>
            <!-- END OF STICKY HEADER CONTAINER -->

            <div class="tab-content" id="pills-tabContent">
                <!-- Schedule View -->
                {% for item in d -%}
                <div
                    class="tab-pane fade show"
                    id="pills-{{item.day}}"
                    role="tabpanel"
                    aria-labelledby="pills-{{item.day}}-tab"
                    tabindex="0"
                >
                    <div class="accordion" id="accordion{{item.day}}">
                        {% for session in item.data -%}
                        <div class="accordion-item">
                            <h2
                                class="accordion-header d-flex justify-content-between align-items-center"
                            >
                                <button
                                    class="accordion-button collapsed"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#collapse{{session.id}}"
                                    aria-expanded="false"
                                    aria-controls="collapse{{session.id}}"
                                >
                                    {{session.title}} <br />
                                    {{session.time}}. {{session.location}}
                                </button>
                                <button
                                    type="button"
                                    class="fav-btn"
                                    data-type="session"
                                    data-id="{{session.id}}"
                                    data-time="{{session.startdatetime}}"
                                    data-location="{{session.location}}"
                                    title="Favorite"
                                >
                                    <img src="./star.svg" alt="Favorite" />
                                </button>
                            </h2>
                            <div
                                id="collapse{{session.id}}"
                                class="accordion-collapse collapse"
                                data-bs-parent="#accordion{{item.day}}"
                            >
                                <div class="accordion-body">
                                    {% for talk in session.talk -%}
                                    <div class="d-flex align-items-center mb-2">
                                        <button
                                            type="button"
                                            class="btn btn-light text-start pseudo-btn"
                                            data-bs-toggle="modal"
                                            data-bs-target="#globalTalkModal"
                                            data-time="{{talk.start_time}}. "
                                            data-title="{{escape_html(talk.title)}}"
                                            data-abstract="{{escape_html(talk.abstract)}}"
                                            data-meta="{{talk.day}}, {{talk.start_time}}. {{talk.location}}"
                                            data-id="{{talk.id}}"
                                            data-location="{{talk.location}}"
                                            data-datetime="{{talk.startdatetime}}"
                                        >
                                            {{talk.title}}
                                        </button>
                                        <button
                                            type="button"
                                            class="fav-btn"
                                            data-type="talk"
                                            data-id="{{talk.id}}"
                                            data-time="{{talk.startdatetime}}"
                                            data-location="{{talk.location}}"
                                            title="Favorite"
                                        >
                                            <img
                                                src="./star.svg"
                                                alt="Favorite"
                                            />
                                        </button>
                                    </div>
                                    {% endfor -%}
                                </div>
                            </div>
                        </div>
                        {% endfor -%}
                    </div>
                </div>
                {% endfor -%}

                <!-- Authors View -->
                <div
                    class="tab-pane fade"
                    id="pills-authors"
                    role="tabpanel"
                    aria-labelledby="pills-authors-tab"
                    tabindex="0"
                >
                    <div class="accordion" id="accordion-authors">
                        {% for author in authors -%}
                        <div
                            class="accordion-item"
                            data-id="{{author.author_id}}"
                            data-name="{{author.name}}"
                        >
                            <h2
                                class="accordion-header d-flex justify-content-between align-items-center"
                            >
                                <button
                                    class="accordion-button collapsed"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#collapse{{author.author_id}}"
                                    aria-expanded="false"
                                    aria-controls="collapse{{author.author_id}}"
                                >
                                    <div class="text-start">
                                        <strong>{{author.name}}</strong><br />
                                        <small class="text-muted fw-normal"
                                            >{{author.affiliation}}</small
                                        >
                                    </div>
                                </button>
                            </h2>
                            <div
                                id="collapse{{author.author_id}}"
                                class="accordion-collapse collapse"
                                data-bs-parent="#accordion-authors"
                            >
                                <div class="accordion-body">
                                    {% for talk in author.data -%}
                                    <div class="d-flex align-items-center mb-2">
                                        <button
                                            type="button"
                                            class="btn btn-light text-start author-talk-btn"
                                            data-bs-toggle="modal"
                                            data-bs-target="#globalTalkModal"
                                            data-id="{{talk.id}}"
                                        >
                                            {{talk.daytimelocation}}.
                                            <strong>{{talk.title}}</strong>
                                        </button>
                                        <button
                                            type="button"
                                            class="fav-btn"
                                            data-type="talk"
                                            data-id="{{talk.id}}"
                                            data-time="{# talk.startdatetime #}"
                                            data-location="{# talk.location #}"
                                            data-title="{# talk.title #}"
                                            title="Favorite"
                                            alt="Favorite"
                                        >
                                            <img
                                                src="./star.svg"
                                                alt="Favorite"
                                            />
                                        </button>
                                    </div>
                                    {% endfor -%}
                                </div>
                            </div>
                        </div>
                        {% endfor -%}
                    </div>
                </div>
            </div>
        </div>

        <!-- View for Favorites -->
        <div id="app-favorites-view" style="display: none">
            <h3 class="mb-4" style="padding-left: 10px">Favorites</h3>
            <div id="favorites-list"></div>
        </div>

        <!-- Bottom Navigation Bar -->
        <nav
            class="fixed-bottom bg-white border-top shadow-sm"
            style="height: 60px"
        >
            <div
                class="container d-flex justify-content-around align-items-center"
            >
                <a
                    href="#"
                    id="btn-nav-schedule"
                    class="text-decoration-none text-dark text-center nav-link-btn"
                >
                    <img src="./calendar3.svg" class="fs-4" alt="Calendar" />
                    <div style="font-size: 10px">Schedule</div>
                </a>
                <a
                    href="#"
                    id="btn-nav-favorites"
                    class="text-decoration-none text-muted text-center nav-link-btn"
                >
                    <img src="./star.svg" class="fs-4" alt="Star" />
                    <div style="font-size: 10px">Favorites</div>
                </a>
            </div>
        </nav>

        <!-- Global Modals Container -->
        <div id="global-modals">
            <div
                class="modal fade"
                id="globalTalkModal"
                tabindex="-1"
                aria-labelledby="globalTalkModalLabel"
                aria-hidden="true"
            >
                <div class="modal-dialog modal-dialog-scrollable">
                    <div class="modal-content">
                        <div
                            class="modal-header d-flex justify-content-between align-items-center"
                        >
                            <span id="modal-talk-meta"></span>
                            <div class="d-flex align-items-center gap-3">
                                <button
                                    type="button"
                                    id="modal-fav-btn"
                                    class="fav-btn"
                                    data-type="talk"
                                    data-id=""
                                    title="Favorite"
                                >
                                    <img src="./star.svg" alt="Favorite" />
                                </button>
                                <button
                                    type="button"
                                    class="btn-close"
                                    data-bs-dismiss="modal"
                                    aria-label="Close"
                                ></button>
                            </div>
                        </div>
                        <div class="modal-body" id="modal-talk-abstract"></div>
                        <div class="modal-footer">
                            <button
                                type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal"
                            >
                                Close
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <script src="bootstrap.bundle.min.js"></script>

        <script>
            // // From Gemini
            // const globalModal = document.getElementById("globalTalkModal");
            // globalModal.addEventListener("show.bs.modal", function (event) {
            //     // Button that triggered the modal
            //     const button = event.relatedTarget;

            //     // Extract info from data-* attributes
            //     const title = button.getAttribute("data-title");
            //     const abstract = button.getAttribute("data-abstract");
            //     const meta = button.getAttribute("data-meta");
            //     const id = button.getAttribute("data-id");
            //     const datetime = button.getAttribute("data-datetime");
            //     const location = button.getAttribute("data-location");

            //     // Update the modal's content
            //     document.getElementById("modal-talk-meta").textContent = meta;
            //     document.getElementById("modal-talk-abstract").innerHTML =
            //         abstract;

            //     // Update the favorite button inside the modal dynamically
            //     const favBtn = document.getElementById("modal-fav-btn");
            //     favBtn.setAttribute("data-id", id);
            //     favBtn.setAttribute("data-time", datetime);
            //     favBtn.setAttribute("data-location", location);
            //     favBtn.setAttribute("data-title", title);

            //     // Trigger your icon state sync function
            //     updateFavoriteIcons("talk", id);
            // });
