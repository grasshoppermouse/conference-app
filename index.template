<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>HBES 2027</title>
        <meta name="theme-color" content="#18bc9c" />
        <link rel="manifest" href="manifest.json" />
        <link href="bootstrap.min.css" rel="stylesheet" />
        <link rel="stylesheet" href="bootstrap-icons.min.css" />
        <style>
            .fav-btn {
                cursor: pointer;
                padding: 0;
                margin-left: 8px;
                border: none;
                background: none;
                color: #ffc107;
                /* Bootstrap warning color for yellow/gold */
            }
            body {
                padding-bottom: 70px; /* Prevent content from being covered by the menubar */
            }

            .nav-item_active {
                color: #18bc9c !important; /* Match your theme color */
            }
        </style>
    </head>

    <body>
        <div class="container-fluid">
            <h3>HBES 2027</h3>
            <ul class="nav nav-pills mb-3" id="pills-tab" role="tablist">
                {% for item in d -%}
                <li class="nav-item" role="presentation">
                    <button
                        class="nav-link"
                        id="pills-{{item.day}}-tab"
                        data-bs-toggle="pill"
                        data-bs-target="#pills-{{item.day}}"
                        type="button"
                        role="tab"
                        aria-controls="pills-{{item.day}}"
                        aria-selected="true"
                    >
                        {{item.day}}
                    </button>
                </li>
                {% endfor -%}
                <li class="nav-item ms-auto" role="presentation">
                    <button
                        class="nav-link"
                        id="pills-authors-tab"
                        data-bs-toggle="pill"
                        data-bs-target="#pills-authors"
                        type="button"
                        role="tab"
                        aria-controls="pills-authors"
                        aria-selected="true"
                    >
                        <i class="bi bi-person fs-4"></i>
                        <!--<div style="font-size: 10px">Authors</div>-->
                    </button>
                </li>
            </ul>

            <div class="tab-content" id="pills-tabContent">
                {% for item in d -%}
                <div
                    class="tab-pane fade show"
                    id="pills-{{item.day}}"
                    role="tabpanel"
                    aria-labelledby="pills-{{item.day}}-tab"
                    tabindex="0"
                >
                    <div class="accordion" id="accordion{{item.day}}">
                        {% for session in item.data -%}
                        <div class="accordion-item">
                            <h2
                                class="accordion-header d-flex justify-content-between align-items-center"
                            >
                                <button
                                    class="accordion-button"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#collapse{{session.id}}"
                                    aria-expanded="true"
                                    aria-controls="collapse{{session.id}}"
                                >
                                    {{session.time}}. {{session.title}}<br />
                                    {{session.location}}
                                </button>
                                <button
                                    type="button"
                                    class="fav-btn"
                                    data-type="session"
                                    data-id="{{session.id}}"
                                    title="Favorite"
                                >
                                    <img src="./star.svg" alt="Favorite" />
                                </button>
                            </h2>
                            <div
                                id="collapse{{session.id}}"
                                class="accordion-collapse collapse"
                                data-bs-parent="#accordion{{item.day}}"
                            >
                                <div class="accordion-body">
                                    {% for talk in session.talk -%}
                                    <div class="d-flex align-items-center">
                                        <button
                                            type="button"
                                            class="btn btn-light text-start"
                                            data-bs-toggle="modal"
                                            data-bs-target="#Modal{{talk.id}}"
                                        >
                                            {{talk.start_time}}.
                                            {{talk.html_title}}
                                        </button>
                                        <button
                                            type="button"
                                            class="fav-btn"
                                            data-type="talk"
                                            data-id="{{talk.id}}"
                                            title="Favorite"
                                        >
                                            <img
                                                src="./star.svg"
                                                alt="Favorite"
                                            />
                                        </button>
                                    </div>
                                    {% endfor -%}
                                </div>
                            </div>
                        </div>
                        {% endfor -%}
                    </div>
                </div>
                {% endfor -%}
                <div
                    class="tab-pane fade show"
                    id="pills-authors"
                    role="tabpanel"
                    aria-labelledby="pills-authors-tab"
                    tabindex="0"
                >
                    <div class="accordion" id="accordion-authors">
                    {% for author in authors -%}
                    <div class="accordion-item">
                        <h2
                            class="accordion-header d-flex justify-content-between align-items-center"
                        >
                            <button
                                class="accordion-button"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#collapse{{author.author_id}}"
                                aria-expanded="true"
                                aria-controls="collapse{{author.author_id}}"
                            >
                                {{author.data.0.author_name}}
                            </button>
                        </h2>
                        <div
                            id="collapse{{author.author_id}}"
                            class="accordion-collapse collapse"
                            data-bs-parent="#accordion-authors"
                        >
                            <div class="accordion-body">
                                {% for talk in author.data -%}
                                <div class="d-flex align-items-center">
                                    <a
                                        href="#"
                                        class="btn btn-light text-start"
                                        data-bs-toggle="modal"
                                        data-bs-target="#Modal{{talk.abstract}}"
                                    >
                                        {{talk.daytimelocation}}. <strong>{{talk.title}}</strong>
                                    </a>
                                    <button
                                        type="button"
                                        class="fav-btn"
                                        data-type="talk"
                                        data-id="{{talk.abstract}}"
                                        title="Favorite"
                                    >
                                        <img src="./star.svg" alt="Favorite" />
                                    </button>
                                </div>
                                {% endfor -%}
                            </div>
                        </div>
                    </div>
                    {% endfor -%}
                </div>
            </div>
        </div>

        <!-- Bottom Navigation Bar -->
        <nav
            class="fixed-bottom bg-white border-top shadow-sm"
            style="height: 60px"
        >
            <div
                class="container d-flex justify-content-around align-items-center"
            >
                <a
                    href="#pills-tabContent"
                    class="text-decoration-none text-dark text-center"
                >
                    <i class="bi bi-calendar3 fs-4"></i>
                    <div style="font-size: 10px">Schedule</div>
                </a>
                <a
                    href="#"
                    class="text-decoration-none text-muted text-center"
                    id="nav-favorites"
                    data-toggle-fav="true"
                >
                    <i class="bi bi-star fs-4"></i>
                    <div style="font-size: 10px">Favorites</div>
                </a>
            </div>
        </nav>

        <!-- Global Modals Container -->
        <div class="modals-container">
          {% for item in d -%}
            {% for session in item.data -%}
              {% for talk in session.talk -%}
                <div class="modal fade" id="Modal{{talk.id}}" tabindex="-1" aria-hidden="true">
                  <div class="modal-dialog modal-dialog-scrollable">
                    <div class="modal-content">
                      <div class="modal-header d-flex justify-content-between align-items-center">
                        <h6 class="modal-title">Abstract</h6>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        <button
                            type="button"
                            class="fav-btn"
                            data-type="talk"
                            data-id="{{talk.id}}"
                            title="Favorite"
                        >
                            <img
                                src="./star.svg"
                                alt="Favorite"
                            />
                        </button>
                      </div>
                      <div class="modal-body">
                        {{talk.abstract}}
                      </div>
                      <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                      </div>
                    </div>
                  </div>
                </div>
                <!-- If you have authors loop, you'd do the same here or ensure unique IDs -->
              {% endfor -%}
            {% endfor -%}
          {% endfor -%}
        </div>

        <!-- Scripts -->
        <script src="bootstrap.bundle.min.js"></script>

        <script>
            document.addEventListener("DOMContentLoaded", () => {
                const favorites = JSON.parse(
                    localStorage.getItem("conference_favorites") || "{}",
                );

                function updateFavoriteIcons(type, id) {
                    const key = `${type}:${id}`;
                    const isFav = !!favorites[key];
                    const buttons = document.querySelectorAll(
                        `.fav-btn[data-type="${type}"][data-id="${id}"]`,
                    );
                    buttons.forEach((btn) => {
                        const img = btn.querySelector("img");
                        if (isFav) {
                            img.src = "./star-fill.svg";
                        } else {
                            img.src = "./star.svg";
                        }
                    });
                }

                // Initial render of favorite icons
                document.querySelectorAll(".fav-btn").forEach((btn) => {
                    updateFavoriteIcons(btn.dataset.type, btn.dataset.id);
                });

                document.querySelectorAll(".fav-btn").forEach((btn) => {
                    btn.addEventListener("click", () => {
                        const id = btn.dataset.id;
                        const type = btn.dataset.type;
                        const key = `${type}:${id}`;

                        if (favorites[key]) {
                            delete favorites[key];
                        } else {
                            favorites[key] = true;
                        }

                        localStorage.setItem(
                            "conference_favorites",
                            JSON.stringify(favorites),
                        );
                        updateFavoriteIcons(type, id);
                    });
                });
            });
        </script>

        <script>
            if ("serviceWorker" in navigator) {
                window.addEventListener("load", () => {
                    navigator.serviceWorker
                        .register("./sw.js")
                        .then((registration) => {
                            console.log(
                                "Service worker with scope:",
                                registration.scope,
                            );
                        })
                        .catch((error) => {
                            console.log(
                                "Service worker registration failed:",
                                error,
                            );
                        });
                });
            }
        </script>
    </body>
</html>
