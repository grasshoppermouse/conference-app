<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{conference_title}}</title>
    <meta name="theme-color" content="#ecb73c" />
    <link rel="manifest" href="manifest.json" />
    <link href="bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="bootstrap-icons.min.css" />

    <link rel="apple-touch-icon" href="ios/apple-icon-180.png" />
    <meta name="apple-touch-fullscreen" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="{{conference_title}}" />

    <style>
        .fav-btn {
            cursor: pointer;
            padding: 0;
            margin-left: 8px;
            border: none;
            background: none;
            color: #ffc107;
            /* Bootstrap warning color for yellow/gold */
        }

        body {
            padding-bottom: 70px;
            /* Prevent content from being covered by the menubar */
        }

        .nav-item_active {
            color: #ecb73c !important;
            /* Match your theme color */
        }

        /* Highlight for active bottom nav items */
        .nav-link-btn.active-nav {
            color: #ecb73c !important;
            /* Your theme's teal color */
            font-weight: bold;
            transform: scale(1.1);
            transition: all 0.2s ease-in-out;
        }

        .pseudo-btn::before {
            content: attr(data-time);
        }

        .accordion-item {
            scroll-margin-top: 240px;
            /* Adjust this value to give it a nice cushion at the top */
        }

        .accordion-button {
            /* Balance padding to give text maximum breathing room */
            padding-right: 0.5rem !important;
        }

        .accordion-button::after {
            /* Optional: Shifting or scaling down the accordion chevron slightly if it competes for space */
            transform: scale(0.85);
        }

        ol.affiliations {
            list-style: none;
            padding: 0;
            margin: 0;
            display: inline;
            counter-reset: aff-counter;
        }

        ol.affiliations li {
            display: inline;
            counter-increment: aff-counter;
            /* margin-right: 5px; */
        }

        /* Explicitly generate numbers before each inline item */
        ol.affiliations li::before {
            content: counter(aff-counter) ". ";
            font-weight: 500;
        }
    </style>
    <script src="html5-qrcode.min.js" type="text/javascript"></script>
</head>

<body class="pb-70">
    <!-- Main Content View -->
    <div id="app-main-content" class="container-fluid">
        <!-- START OF STICKY HEADER CONTAINER -->
        <div class="sticky-top bg-white pt-3 pb-2 mb-3 border-bottom" style="top: 0; z-index: 1020">
            <h3 class="mb-3">{{conference_title}}</h3>
            <div class="mb-3">
                <div class="input-group">
                    <input type="text" id="search-input" class="form-control form-control-lg"
                        placeholder="Search talks by title or abstract..." autocomplete="off" />
                    <!-- QR Code Scan Trigger Button -->
                    <button class="btn btn-outline-secondary" type="button" id="btn-scan-qr" title="Scan Badge QR">
                        <img src="./qr-code-scan.svg" alt="QRcode" />
                    </button>
                    <button class="btn btn-outline-secondary" type="button" id="clear-search">
                        <img src="./x.svg" alt="X" />
                    </button>
                </div>
                <div id="search-results" class="list-group mt-2" style="max-height: 300px; overflow-y: auto"></div>
            </div>
            {% set days = ['Wed', 'Thu', 'Fri', 'Sat'] %}
            <ul class="nav nav-pills mb-3" id="pills-tab" role="tablist">
                {% for day in days %}
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="pills-{{day}}-tab" data-bs-toggle="pill"
                        data-bs-target="#pills-{{day}}" type="button" role="tab" aria-controls="pills-{{day}}"
                        aria-selected="true">
                        {{day}}
                    </button>
                </li>
                {% endfor %}
                <li class="nav-item ms-auto" role="presentation">
                    <button class="nav-link" id="pills-authors-tab" data-bs-toggle="pill"
                        data-bs-target="#pills-authors" type="button" role="tab" aria-controls="pills-authors"
                        aria-selected="false">
                        <img src="./person.svg" alt="Person" />
                    </button>
                </li>
            </ul>
        </div>
        <!-- END OF STICKY HEADER CONTAINER -->

        <div class="tab-content" id="pills-tabContent">
            <!-- Schedule View -->
            {% for day in days %}
            <div class="tab-pane fade show" id="pills-{{day}}" role="tabpanel" aria-labelledby="pills-{{day}}-tab"
                tabindex="0">
                <div class="accordion" id="accordion{{day}}">
                    {% for session in sessions[day] %}
                    <div class="accordion-item">
                        <h2 class="accordion-header d-flex justify-content-between align-items-center">
                            <!-- Session details toggle button -->
                            <button class="accordion-button collapsed flex-grow-1" type="button"
                                data-bs-toggle="collapse" data-bs-target="#collapse{{session.id}}" aria-expanded="false"
                                aria-controls="collapse{{session.id}}">
                                <div class="pe-2">
                                    <span class="fw-bold d-block mb-1"
                                        style="line-height: 1.3">{{session.slotTitle}}</span>
                                    <small class="text-muted fw-normal">{{session.start_time}}.
                                        {{session.location}}</small>
                                </div>
                            </button>

                            <!-- Vertically Stacked Action Panel -->
                            <div class="d-flex flex-column align-items-center justify-content-center border-start ps-2 pe-3 py-1 bg-white"
                                style="min-width: 45px; z-index: 2">
                                <!-- Favorite Button on Top -->
                                <button type="button" class="fav-btn p-1 mb-1" data-type="session"
                                    data-id="{{session.id}}" data-title="{{session.title}}"
                                    data-time="{{session.startdatetime}}" data-location="{{session.location}}"
                                    title="Favorite">
                                    <img src="./star.svg" alt="Favorite" style="width: 18px; height: 18px" />
                                </button>

                                <!-- Share Button on Bottom -->
                                <button type="button" class="btn btn-link p-1 text-muted share-btn" data-route="session"
                                    data-id="{{session.id}}" data-title="{{session.slotTitle}}" title="Share Session">
                                    <img class="share-icon" src="./share.svg" alt="Share" />
                                </button>
                            </div>
                        </h2>
                        <div id="collapse{{session.id}}" class="accordion-collapse collapse"
                            data-bs-parent="#accordion{{day}}">
                            <div class="accordion-body">
                                {% for talk in session['talks'] %}
                                <div class="d-flex align-items-center mb-2">
                                    <button type="button" class="btn btn-light text-start pseudo-btn"
                                        data-bs-toggle="modal" data-bs-target="#globalTalkModal"
                                        data-time="{{talk.start_time}}. " data-title="{{talk.title}}"
                                        data-meta="{{talk.day}}, {{talk.start_time}}. {{talk.location}}"
                                        data-id="{{talk.id}}" data-location="{{talk.location}}"
                                        data-datetime="{{talk.startdatetime}}">
                                        {{talk.title}}
                                    </button>
                                    <button type="button" class="btn btn-link p-0 text-muted ms-2 share-btn"
                                        data-route="talk" data-id="{{talk.id}}" data-title="{{talk.title}}"
                                        title="Share Talk">
                                        <img class="share-icon" src="./share.svg" alt="Share" />
                                    </button>
                                    <button type="button" class="fav-btn" data-type="talk" data-id="{{talk.id}}"
                                        data-title="{{talk.title}}" data-time="{{talk.startdatetime}}"
                                        data-location="{{talk.location}}" title="Favorite">
                                        <img src="./star.svg" alt="Favorite" />
                                    </button>
                                </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
            {% endfor %}

            <!-- Authors View -->
            <div class="tab-pane fade" id="pills-authors" role="tabpanel" aria-labelledby="pills-authors-tab"
                tabindex="0">
                <div class="accordion" id="accordion-authors">
                    <!-- Dynamic Loader Placeholder -->
                    <div class="text-center py-5" id="authors-tab-loader">
                        <div class="spinner-border text-warning" role="status">
                            <span class="visually-hidden">Loading authors...</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- View for Favorites -->
    <div id="app-favorites-view" style="display: none">
        <div class="d-flex justify-content-between align-items-center px-2 mb-4">
            <h3 class="m-0">Favorites</h3>
            <!-- Export Schedule Trigger Button -->
            <button type="button" id="btn-export-favorites" class="btn btn-link btn-sm d-flex align-items-center gap-1">
                <img id="share-icon-img" class="share-icon" src="./share.svg" alt="Share" />
            </button>
        </div>
        <div id="favorites-list"></div>
    </div>

    <!-- Bottom Navigation Bar -->
    <nav class="fixed-bottom bg-white border-top shadow-sm" style="height: 60px">
        <div class="container d-flex justify-content-around align-items-center">
            <a href="#" id="btn-nav-schedule" class="text-decoration-none text-dark text-center nav-link-btn">
                <img src="./calendar3.svg" class="fs-4" alt="Calendar" />
                <div style="font-size: 10px">Schedule</div>
            </a>
            <a href="#" id="btn-nav-favorites" class="text-decoration-none text-muted text-center nav-link-btn">
                <img src="./star.svg" class="fs-4" alt="Star" />
                <div style="font-size: 10px">Favorites</div>
            </a>
        </div>
    </nav>

    <!-- Global Modals Container -->
    <div id="global-modals">
        <div class="modal fade" id="globalTalkModal" tabindex="-1" aria-labelledby="globalTalkModalLabel"
            aria-hidden="true">
            <div class="modal-dialog modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header d-flex justify-content-between align-items-center">
                        <span id="modal-talk-meta"></span>
                        <div class="d-flex align-items-center gap-3">
                            <button type="button" id="modal-copy-btn" class="btn btn-link p-0 text-muted share-btn"
                                data-route="talk" data-id="" data-title="" title="Share Talk">
                                <img class="share-icon" src="./share.svg" alt="Share" />
                            </button>
                            <button type="button" id="modal-fav-btn" class="fav-btn" data-type="talk" data-id=""
                                title="Favorite">
                                <img src="./star.svg" alt="Favorite" />
                            </button>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                    </div>
                    <div class="modal-body" id="modal-talk-abstract"></div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            Close
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="qrScannerModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Scan Participant Badge</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body bg-dark p-0 position-relative">
                    <!-- Camera view area -->
                    <div id="qr-video-reader" style="width: 100%"></div>
                </div>
            </div>
        </div>
    </div>
    <script src="bootstrap.bundle.min.js"></script>

    <script>
        // Platform detection and share icon setup
        const isAppleDevice = /Mac|iPhone|iPad|iPod/.test(navigator.userAgent);
        const shareIconSrc = isAppleDevice ? "./box-arrow-up.svg" : "./share.svg";

        function updatePlatformIcons() {
            document.querySelectorAll(".share-icon").forEach((img) => {
                img.src = shareIconSrc;
            });
        }

        // Utility function to convert HTML abstract strings into clean plain text
        function convertAbstractToPlainText(htmlString) {
            if (!htmlString) return "";
            const doc = new DOMParser().parseFromString(htmlString, 'text/html');
            doc.querySelectorAll('p, div, br').forEach((el) => {
                if (el.tagName.toLowerCase() === 'br') {
                    el.replaceWith('\n');
                } else {
                    el.appendChild(doc.createTextNode('\n'));
                }
            });
            return doc.body.textContent
                .split('\n')
                .map((line) => line.trim())
                .filter((line) => line.length > 0)
                .join('\n');
        }

        // Helper function to handle active state toggling
        function setActiveNav(btnId) {
            const scheduleBtn = document.getElementById("btn-nav-schedule");
            const favsBtn = document.getElementById("btn-nav-favorites");

            if (scheduleBtn) scheduleBtn.classList.remove("active-nav");
            if (favsBtn) favsBtn.classList.remove("active-nav");

            const activeBtn = document.getElementById(btnId);
            if (activeBtn) activeBtn.classList.add("active-nav");
        }

        // Safe LocalStorage Retrieval
        const favorites = JSON.parse(localStorage.getItem("conference_favorites") || "{}") || {};

        // Index Initialization with Fallbacks
        let talkIndex = {{ talks | default ({}) }} || {};
        let authorIndex = {{ authors | default ({}) }} || {};

        document.addEventListener("DOMContentLoaded", () => {
            const mainContent = document.getElementById("app-main-content");
            const favsZone = document.getElementById("app-favorites-view");

            const scheduleBtn = document.getElementById("btn-nav-schedule");
            if (scheduleBtn) scheduleBtn.classList.add("active-nav");

            // Update all share icons for native platform look
            updatePlatformIcons();

            // Initial render of favorite icons
            document.querySelectorAll(".fav-btn").forEach((btn) => {
                updateFavoriteIcons(btn.dataset.type, btn.dataset.id);
            });

            const searchInput = document.getElementById("search-input");
            const tabElements = document.querySelectorAll(
                'button[data-bs-toggle="pill"], a[data-bs-toggle="pill"]',
            );

            tabElements.forEach((tab) => {
                tab.addEventListener("shown.bs.tab", function (event) {
                    const activeTabId = event.target.id;

                    if (activeTabId === "pills-authors-tab") {
                        if (searchInput) searchInput.placeholder = "Search authors...";
                        renderAuthorsSkeleton();
                    } else if (searchInput) {
                        searchInput.placeholder = "Search talks by title or abstract...";
                    }
                });
            });

            // Favorite button click logic
            document.body.addEventListener("click", (e) => {
                const btn = e.target.closest(".fav-btn");
                if (!btn) return;

                const id = btn.dataset.id;
                const type = btn.dataset.type;
                const key = `${type}:${id}`;

                let labelText = "Favorite Item";
                if (btn.dataset.title) {
                    labelText = btn.dataset.title;
                } else if (btn.parentElement?.querySelector("button")) {
                    labelText = btn.parentElement.querySelector("button").innerText;
                } else if (btn.closest(".d-flex")) {
                    const otherBtn = btn.closest(".d-flex").querySelector("button");
                    if (otherBtn) labelText = otherBtn.innerText;
                }
                labelText = labelText.split("\n")[0];

                if (favorites[key]) {
                    delete favorites[key];
                } else {
                    favorites[key] = {
                        title: labelText,
                        time: btn.dataset.time || "",
                        location: btn.dataset.location || "",
                        timestamp: new Date().toLocaleString(),
                    };
                }

                localStorage.setItem("conference_favorites", JSON.stringify(favorites));
                updateFavoriteIcons(type, id);

                const favsBtn = document.getElementById("btn-nav-favorites");
                if (favsBtn && favsBtn.classList.contains("active-nav")) {
                    renderFavoritesList();
                }
            });

            // Navigation Listeners
            document.getElementById("btn-nav-schedule")?.addEventListener("click", (e) => {
                e.preventDefault();
                if (mainContent) mainContent.style.display = "block";
                if (favsZone) favsZone.style.display = "none";
                setActiveNav("btn-nav-schedule");
            });

            document.getElementById("btn-nav-favorites")?.addEventListener("click", (e) => {
                e.preventDefault();
                if (mainContent) mainContent.style.display = "none";
                if (favsZone) favsZone.style.display = "block";
                renderFavoritesList();
                setActiveNav("btn-nav-favorites");
            });

            document.getElementById("btn-export-favorites")?.addEventListener("click", async () => {
                const storedFavs = JSON.parse(localStorage.getItem("conference_favorites") || "{}") || {};
                const keys = Object.keys(storedFavs);
                const talkKeys = keys.filter((key) => key.startsWith("talk:"));

                if (talkKeys.length === 0) {
                    alert("You don't have any favorited talks to export yet!");
                    return;
                }

                const convertAbstractToPlainText = (htmlString) => {
                    if (!htmlString) return "";
                    const doc = new DOMParser().parseFromString(htmlString, 'text/html');
                    doc.querySelectorAll('p, div, br').forEach((el) => {
                        if (el.tagName.toLowerCase() === 'br') {
                            el.replaceWith('\n');
                        } else {
                            el.appendChild(doc.createTextNode('\n'));
                        }
                    });
                    return doc.body.textContent
                        .split('\n')
                        .map((line) => line.trim())
                        .filter((line) => line.length > 0)
                        .join('\n');
                };

                let compiledTalks = talkKeys.map((key) => {
                    const [_, id] = key.split(":");
                    const talkData = (talkIndex || {})[id];
                    const favItem = storedFavs[key] || {};

                    return {
                        time: talkData ? talkData.startdatetime : favItem.time || "",
                        metaTime: talkData ? `${talkData.day || ''}, ${talkData.start_time || ''}` : "",
                        location: talkData ? talkData.location : favItem.location || "",
                        formattedContent: talkData && talkData.abstract
                            ? convertAbstractToPlainText(talkData.abstract)
                            : `📌 ${favItem.title || 'Talk'}`
                    };
                });

                compiledTalks.sort((a, b) => new Date(a.time) - new Date(b.time));

                let exportText = "{{conference_title}} - My Saved Talks & Abstracts\n";
                exportText += "========================================\n\n";

                compiledTalks.forEach((talk) => {
                    exportText += talk.formattedContent + "\n";
                    if (talk.metaTime) exportText += `⏰ SCHEDULED TIME: ${talk.metaTime}\n`;
                    if (talk.location) exportText += `📍 LOCATION: ${talk.location}\n`;
                    exportText += "\n----------------------------------------\n\n";
                });

                if (navigator.share) {
                    try {
                        await navigator.share({
                            title: "My {{conference_title}} Presentation Abstracts",
                            text: exportText
                        });
                    } catch (err) {
                        if (err.name !== "AbortError") {
                            console.error("Native OS web share pipeline failed:", err);
                        }
                    }
                } else {
                    await copyToClipboardFallback(exportText, document.getElementById("btn-export-favorites"));
                }
            });

            function renderFavoritesList() {
                const listContainer = document.getElementById("favorites-list");
                if (!listContainer) return;

                const keys = Object.keys(favorites || {});
                if (keys.length === 0) {
                    listContainer.innerHTML = '<p class="text-muted">No favorites yet.</p>';
                    return;
                }

                let favItems = keys.map((key) => ({
                    key: key,
                    data: favorites[key] || {},
                }));

                favItems.sort((a, b) => new Date(a.data.time || 0) - new Date(b.data.time || 0));

                listContainer.innerHTML = "";

                favItems.forEach((item) => {
                    const [type, id] = item.key.split(":");
                    const data = item.data;
                    const isFav = !!favorites[`${type}:${id}`];
                    const starImg = isFav ? "./star-fill.svg" : "./star.svg";

                    const cardElement = document.createElement("div");
                    cardElement.className = "card rounded-0 mb-0";

                    let content = "";
                    let formattedTime = "";

                    if (data.time) {
                        const dateObj = new Date(data.time);
                        formattedTime =
                            dateObj.toLocaleDateString("en-US", {
                                weekday: "long",
                                month: "short",
                                day: "numeric",
                            }) +
                            " - " +
                            dateObj.toLocaleTimeString("en-US", {
                                hour: "2-digit",
                                minute: "2-digit",
                            });
                    }

                    let modalAttributes = type === "talk" ? `role="button" tabindex="0" data-bs-toggle="modal" data-bs-target="#globalTalkModal" data-id="${id}"` : "";
                    content += `<div class="flex-grow-1 text-start" ${modalAttributes}>`;
                    content += `  <h6 class="${type === "talk" ? "mb-1 text-primary" : "mb-1 text-success"}">${data.title || ''}</h6>`;

                    if (data.time) {
                        content += `  <p class="mb-0 small text-muted"><img src="./calendar.svg" alt="Calendar" /> ${formattedTime}</p>`;
                    }
                    if (data.location) {
                        content += `  <p class="mb-0 small text-muted"><img src="./geo-alt.svg" alt="Location" /> ${data.location}</p>`;
                    }
                    content += `</div>`;

                    content += `<div>`;
                    content += `  <button type="button" class="fav-btn btn btn-link p-0 ms-3"
                                data-type="${type}"
                                data-id="${id}"
                                data-time="${data.time || ""}"
                                data-location="${data.location || ""}"
                                data-title="${data.title || ""}"
                                title="Favorite">
                                <img src="${starImg}" alt="Favorite" />
                              </button>`;
                    content += `</div>`;

                    const cardBody = document.createElement("div");
                    cardBody.className = "card-body d-flex justify-content-between align-items-center";

                    cardBody.innerHTML = content;
                    cardElement.appendChild(cardBody);
                    listContainer.appendChild(cardElement);
                });
            }
        });

        // --- High-Performance On-Demand Author Rendering ---
        let authorsRendered = false;

        function renderAuthorsSkeleton() {
            if (authorsRendered) return;
            const container = document.getElementById("accordion-authors");
            if (!container) return;

            const fragment = document.createDocumentFragment();

            const sortedAuthors = Object.values(authorIndex || {}).sort((a, b) => {
                const lastNameCompare = (a?.last_name || "").localeCompare(b?.last_name || "");
                if (lastNameCompare !== 0) return lastNameCompare;
                return (a?.first_name || "").localeCompare(b?.first_name || "");
            });

            sortedAuthors.forEach((author) => {
                if (!author) return;
                const fullName = `${author.first_name || ''} ${author.last_name || ''}`.trim();
                const item = document.createElement("div");
                item.className = "accordion-item";
                item.setAttribute("id", `author-row-${author.person_id}`);
                item.setAttribute("data-id", author.person_id);
                item.setAttribute("data-name", fullName);

                item.innerHTML = `
    <h2 class="accordion-header d-flex justify-content-between align-items-center">
        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
            data-bs-target="#collapse${author.person_id}" aria-expanded="false"
            aria-controls="collapse${author.person_id}" data-author-id="${author.person_id}">
            <div class="text-start">
                <strong>${fullName}</strong><br />
                <small class="text-muted fw-normal">${author.affiliation || ''}</small>
            </div>
        </button>
        <button type="button" class="btn btn-link p-0 text-muted me-3 share-btn" data-route="author" data-id="${author.person_id}" data-title="${fullName}" title="Share Author">
            <img class="share-icon" src="${shareIconSrc}" alt="Share" />
        </button>
    </h2>
    <div id="collapse${author.person_id}" class="accordion-collapse collapse"
        data-bs-parent="#accordion-authors">
        <div class="accordion-body" id="author-body-${author.person_id}">
            <div class="text-center py-2">
                <div class="spinner-border spinner-border-sm text-muted" role="status"></div>
            </div>
        </div>
    </div>
`;
                fragment.appendChild(item);
            });

            container.innerHTML = "";
            container.appendChild(fragment);
            authorsRendered = true;
        }

        // Lazy-load author details on expand
        document.getElementById("accordion-authors")?.addEventListener("show.bs.collapse", (e) => {
            const button = e.target.previousElementSibling?.querySelector(".accordion-button");
            if (!button) return;

            const authorId = button.getAttribute("data-author-id");
            const bodyZone = document.getElementById(`author-body-${authorId}`);

            if (bodyZone && bodyZone.querySelector(".spinner-border")) {
                const author = (authorIndex || {})[authorId];
                if (!author || !author.presentations || author.presentations.length === 0) {
                    bodyZone.innerHTML = '<p class="text-muted small mb-0">No sessions listed.</p>';
                    return;
                }

                let html = "";

                if (author.email) {
                    html += `
        <div class="mb-3 border-bottom pb-2">
            <a href="mailto:${author.email}" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center">
                <i class="bi bi-envelope me-2"></i> Contact Author (${author.email})
            </a>
        </div>
    `;
                }

                author.presentations.forEach((talkId) => {
                    const talk = (talkIndex || {})[talkId];
                    if (!talk) return;

                    const safeTitle = (talk.title || "").replace(/"/g, '&quot;');
                    const dayTimeLoc = `${talk.day || ''}, ${talk.start_time || ''}${talk.location ? '. ' + talk.location : ''}`;

                    html += `
        <div class="d-flex align-items-center mb-2">
            <button type="button" class="btn btn-light text-start author-talk-btn"
                data-bs-toggle="modal" data-bs-target="#globalTalkModal" data-id="${talk.id}">
                ${dayTimeLoc}. <strong>${talk.title}</strong>
            </button>
            <button type="button" class="btn btn-link p-0 text-muted ms-2 share-btn" data-route="talk" data-id="${talk.id}" data-title="${safeTitle}" title="Share Talk">
                <img class="share-icon" src="${shareIconSrc}" alt="Share" />
            </button>
            <button type="button" class="fav-btn" data-type="talk" data-id="${talk.id}" data-title="${safeTitle}" title="Favorite">
                <img src="./star.svg" alt="Favorite" />
            </button>
        </div>
    `;
                });
                bodyZone.innerHTML = html;

                author.presentations.forEach((talkId) => {
                    updateFavoriteIcons("talk", talkId);
                });
            }
        });

        function updateFavoriteIcons(type, id) {
            const key = `${type}:${id}`;
            const isFav = !!(favorites || {})[key];
            const buttons = document.querySelectorAll(
                `.fav-btn[data-type="${type}"][data-id="${id}"]`,
            );
            buttons.forEach((btn) => {
                const img = btn.querySelector("img");
                if (img) {
                    img.src = isFav ? "./star-fill.svg" : "./star.svg";
                }
            });
        }

        document.addEventListener("DOMContentLoaded", () => {
            const globalModal = document.getElementById('globalTalkModal');
            if (globalModal) {
                globalModal.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    const id = button ? button.getAttribute('data-id') : globalModal.dataset.activeTalkId;

                    if (id && window.location.hash !== `#/talk/${id}`) {
                        window.location.hash = `#/talk/${id}`;
                    }

                    const talkData = (talkIndex || {})[id];
                    const metaNode = document.getElementById('modal-talk-meta');
                    const abstractNode = document.getElementById('modal-talk-abstract');
                    const modalFavBtn = document.getElementById('modal-fav-btn');
                    const modalCopyBtn = document.getElementById('modal-copy-btn');

                    if (talkData) {
                        if (metaNode) metaNode.textContent = `${talkData.day || ''}, ${talkData.start_time || ''}. ${talkData.location || ''}`;
                        if (abstractNode) abstractNode.innerHTML = talkData.abstract || "<p>Abstract not provided.</p>";

                        modalFavBtn?.setAttribute('data-id', talkData.id);
                        modalFavBtn?.setAttribute('data-title', talkData.title || '');
                        modalFavBtn?.setAttribute('data-time', talkData.startdatetime || '');
                        modalFavBtn?.setAttribute('data-location', talkData.location || '');

                        modalCopyBtn?.setAttribute('data-id', talkData.id);
                        modalCopyBtn?.setAttribute('data-title', talkData.title || '');
                    } else {
                        if (metaNode) metaNode.textContent = button ? button.getAttribute('data-meta') || "" : "";
                        if (abstractNode) abstractNode.innerHTML = button ? button.getAttribute('data-abstract') || "<p>Abstract not found.</p>" : "<p>Abstract not found.</p>";

                        modalFavBtn?.setAttribute('data-id', id);
                        modalFavBtn?.setAttribute('data-title', button ? button.getAttribute('data-title') || "" : "");
                        modalFavBtn?.setAttribute('data-time', button ? (button.getAttribute('data-time') || button.getAttribute('data-datetime')) || "" : "");
                        modalFavBtn?.setAttribute('data-location', button ? button.getAttribute('data-location') || "" : "");

                        modalCopyBtn?.setAttribute('data-id', id);
                        modalCopyBtn?.setAttribute('data-title', button ? button.getAttribute('data-title') || "" : "");
                    }

                    updateFavoriteIcons('talk', id);
                });
            }

            const searchInput = document.getElementById("search-input");
            const searchResults = document.getElementById("search-results");

            if (searchInput && searchResults) {
                searchInput.addEventListener("input", (e) => {
                    const query = e.target.value.toLowerCase().trim();
                    searchResults.innerHTML = "";

                    if (query.length < 2) return;

                    const isAuthorsView = document.getElementById("pills-authors")?.classList.contains("active");
                    let results = [];

                    if (isAuthorsView) {
                        results = Object.values(authorIndex || {}).filter((author) => {
                            if (!author) return false;
                            const fullName = `${author.first_name || ''} ${author.last_name || ''}`.toLowerCase();
                            const affiliation = (author.affiliation || "").toLowerCase();
                            return fullName.includes(query) || affiliation.includes(query);
                        });
                    } else {
                        results = Object.values(talkIndex || {}).filter((talk) =>
                            talk && (
                                (talk.title && talk.title.toLowerCase().includes(query)) ||
                                (talk.abstract && talk.abstract.toLowerCase().includes(query)) ||
                                (talk.id && talk.id.toString().toLowerCase().includes(query))
                            )
                        );
                    }

                    results.forEach((item) => {
                        const resultItem = document.createElement("button");
                        resultItem.className = "list-group-item list-group-item-action d-flex justify-content-between align-items-center";

                        resultItem.dataset.targetId = item.person_id || item.id;
                        resultItem.dataset.isAuthor = isAuthorsView ? "true" : "false";

                        if (isAuthorsView) {
                            resultItem.innerHTML = `<span class="text-start">${item.first_name || ''} ${item.last_name || ''}</span>`;
                        } else {
                            resultItem.innerHTML = `<span class="text-start">${item.day} ${item.start_time}: ${item.title || ''}</span>`;
                        }
                        searchResults.appendChild(resultItem);
                    });
                });

                searchResults.addEventListener("click", (e) => {
                    const btn = e.target.closest("button");
                    if (!btn || !searchResults.contains(btn)) return;

                    const targetId = btn.dataset.targetId;
                    const isAuthor = btn.dataset.isAuthor === "true";

                    if (isAuthor) {
                        const element = document.getElementById(`collapse${targetId}`);
                        if (element) {
                            bootstrap.Collapse.getOrCreateInstance(element, { toggle: false }).show();
                            setTimeout(() => {
                                element.closest('.accordion-item')?.scrollIntoView({ behavior: "smooth", block: "start" });
                            }, 300);
                        }
                    } else {
                        const originalBtn = document.querySelector(`button[data-id="${targetId}"][data-bs-target="#globalTalkModal"]`);
                        const modalInstance = bootstrap.Modal.getOrCreateInstance(globalModal);

                        if (originalBtn) {
                            modalInstance.show(originalBtn);
                        } else {
                            globalModal.dataset.activeTalkId = targetId;
                            modalInstance.show();
                        }
                    }
                });
            }

            document.getElementById("clear-search")?.addEventListener("click", () => {
                if (searchInput) {
                    searchInput.value = "";
                    searchInput.dispatchEvent(new Event("input"));
                }
                if (searchResults) {
                    searchResults.innerHTML = "";
                }
            });
        });

        // Sync Hash Routing
        function handleRouting() {
            const hash = window.location.hash;
            if (!hash) return;

            const parts = hash.split('/');
            if (parts.length < 3) return;

            const routeType = parts[1];
            const id = parts[2];

            const mainContent = document.getElementById("app-main-content");
            const favsZone = document.getElementById("app-favorites-view");

            if (routeType === 'talk') {
                const globalModal = document.getElementById('globalTalkModal');
                if (globalModal) {
                    const originalBtn = document.querySelector(`button[data-id="${id}"][data-bs-target="#globalTalkModal"]`);
                    const modalInstance = bootstrap.Modal.getOrCreateInstance(globalModal);

                    if (originalBtn) {
                        modalInstance.show(originalBtn);
                    } else {
                        globalModal.dataset.activeTalkId = id;
                        modalInstance.show();
                    }
                }
            } else if (routeType === 'session') {
                if (mainContent && favsZone && mainContent.style.display === "none") {
                    mainContent.style.display = "block";
                    favsZone.style.display = "none";
                    setActiveNav("btn-nav-schedule");
                }

                const element = document.querySelector(`.tab-content .tab-pane:not(#pills-authors) #collapse${id}`);
                if (element) {
                    const tabPane = element.closest('.tab-pane');
                    if (tabPane) {
                        const tabTrigger = document.querySelector(`button[data-bs-target="#${tabPane.id}"]`);
                        if (tabTrigger) bootstrap.Tab.getOrCreateInstance(tabTrigger).show();
                    }
                    bootstrap.Collapse.getOrCreateInstance(element).show();
                    setTimeout(() => {
                        element.closest('.accordion-item')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }, 300);
                }
            } else if (routeType === 'author') {
                if (mainContent && favsZone && mainContent.style.display === "none") {
                    mainContent.style.display = "block";
                    favsZone.style.display = "none";
                    setActiveNav("btn-nav-schedule");
                }

                renderAuthorsSkeleton();

                const authorsTabTrigger = document.getElementById('pills-authors-tab');
                if (authorsTabTrigger) bootstrap.Tab.getOrCreateInstance(authorsTabTrigger).show();

                const element = document.querySelector(`#accordion-authors #collapse${id}`);
                if (element) {
                    bootstrap.Collapse.getOrCreateInstance(element).show();
                    setTimeout(() => {
                        element.closest('.accordion-item')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }, 300);
                }
            }
        }

        window.addEventListener('hashchange', handleRouting);
        document.addEventListener('DOMContentLoaded', () => {
            setTimeout(handleRouting, 100);
        });

        document.body.addEventListener('show.bs.collapse', function (event) {
            const collapseEl = event.target;
            if (!collapseEl.id || !collapseEl.id.startsWith('collapse')) return;

            const id = collapseEl.id.replace('collapse', '');

            if (collapseEl.closest('#accordion-authors')) {
                if (window.location.hash !== `#/author/${id}`) window.location.hash = `#/author/${id}`;
            } else {
                if (window.location.hash !== `#/session/${id}`) window.location.hash = `#/session/${id}`;
            }
        });

        document.body.addEventListener('hide.bs.collapse', function (event) {
            const collapseEl = event.target;
            if (!collapseEl.id || !collapseEl.id.startsWith('collapse')) return;

            const id = collapseEl.id.replace('collapse', '');
            if (window.location.hash === `#/session/${id}` || window.location.hash === `#/author/${id}`) {
                window.location.hash = '';
            }
        });

        // QR Scanner Handlers
        let html5QrScanner = null;

        document.getElementById('btn-scan-qr')?.addEventListener('click', () => {
            const qrModalEl = document.getElementById('qrScannerModal');
            if (qrModalEl) {
                const scannerModal = new bootstrap.Modal(qrModalEl);
                scannerModal.show();
            }
        });

        document.getElementById('qrScannerModal')?.addEventListener('shown.bs.modal', () => {
            html5QrScanner = new Html5Qrcode("qr-video-reader");
            const config = { fps: 10, qrbox: { width: 250, height: 250 } };

            html5QrScanner.start(
                { facingMode: "environment" },
                config,
                (decodedText) => {
                    try {
                        const url = decodedText.includes('#') ? new URL(decodedText) : null;
                        const hashValue = url ? url.hash : decodedText;

                        if (hashValue && hashValue.startsWith('#/')) {
                            html5QrScanner.stop().then(() => {
                                const qrModalEl = document.getElementById('qrScannerModal');
                                if (qrModalEl) bootstrap.Modal.getInstance(qrModalEl)?.hide();
                                window.location.hash = hashValue;
                            });
                        }
                    } catch (err) {
                        console.error("Malformed QR data payload parsed.", err);
                    }
                },
                () => { }
            ).catch(err => console.error("Camera access failed or rejected by system settings.", err));
        });

        document.getElementById('qrScannerModal')?.addEventListener('hide.bs.modal', () => {
            if (html5QrScanner && html5QrScanner.isScanning) {
                html5QrScanner.stop().catch(err => console.error("Error killing video track context.", err));
            }
        });

        // Universal Clipboard Copy Fallback (Supports non-secure HTTP connections)
        async function copyToClipboardFallback(textToCopy, btn) {
            try {
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    await navigator.clipboard.writeText(textToCopy);
                } else {
                    const textarea = document.createElement("textarea");
                    textarea.value = textToCopy;
                    textarea.style.position = "fixed";
                    textarea.style.opacity = "0";
                    document.body.appendChild(textarea);
                    textarea.select();
                    document.execCommand("copy");
                    document.body.removeChild(textarea);
                }

                const img = btn?.querySelector('img');
                if (img) {
                    const originalSrc = img.src;
                    img.src = "./link.svg";
                    setTimeout(() => {
                        img.src = originalSrc;
                    }, 1000);
                }
            } catch (err) {
                console.error('Clipboard copy fallback failed:', err);
            }
        }

        // Global Web Share Action Listener
        // Global Web Share Action Listener (Supports Talk Abstracts, file:// & HTTP/HTTPS)
        document.body.addEventListener('click', async (e) => {
            const btn = e.target.closest('.share-btn, .copy-btn');
            if (!btn) return;

            e.preventDefault();
            e.stopPropagation();

            const route = btn.dataset.route;
            const id = btn.dataset.id;
            if (!route || !id) return;

            let plainTextTitle = btn.dataset.title || "";
            let shareText = "";

            if (route === "talk") {
                const talkData = (talkIndex || {})[id];
                plainTextTitle = plainTextTitle || talkData?.title || "";
                const rawAbstract = talkData?.abstract || btn.dataset.abstract || "";
                const plainAbstract = convertAbstractToPlainText(rawAbstract);

                if (plainTextTitle && plainAbstract) {
                    shareText = `${plainTextTitle}\n\n${plainAbstract}`;
                } else {
                    shareText = plainTextTitle || plainAbstract;
                }
            } else if (route === "author") {
                if (!plainTextTitle) {
                    const author = (authorIndex || {})[id];
                    plainTextTitle = author ? `${author.first_name || ''} ${author.last_name || ''}`.trim() : "";
                }
                shareText = plainTextTitle;
            } else {
                // e.g. session
                shareText = plainTextTitle;
            }

            const shareUrl = `${window.location.origin}${window.location.pathname}#/${route}/${id}`;
            const fullSharePayloadText = shareText ? `${shareText}\n\n${shareUrl}` : shareUrl;

            // Base share payload
            const shareData = {
                title: plainTextTitle || "{{conference_title}}",
                text: shareText
            };

            // Safely parse URL and only assign `url` property if scheme is http: or https:
            try {
                const parsedUrl = new URL(shareUrl, window.location.href);
                if (parsedUrl.protocol === 'http:' || parsedUrl.protocol === 'https:') {
                    shareData.url = parsedUrl.href;
                } else {
                    // file:// or non-web schemes: append full payload text with URL
                    shareData.text = fullSharePayloadText;
                }
            } catch (err) {
                shareData.text = fullSharePayloadText;
            }

            if (navigator.share) {
                try {
                    await navigator.share(shareData);
                } catch (err) {
                    if (err.name !== "AbortError") {
                        console.error('Web Share failed, attempting clipboard fallback:', err);
                        await copyToClipboardFallback(fullSharePayloadText, btn);
                    }
                }
            } else {
                await copyToClipboardFallback(fullSharePayloadText, btn);
            }
        });
    </script>
</body>

</html>