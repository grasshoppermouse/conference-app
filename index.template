<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>HBES 2027</title>
    <meta name="theme-color" content="#ecb73c" />
    <link rel="manifest" href="manifest.json" />
    <link href="bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="bootstrap-icons.min.css" />

    <link rel="apple-touch-icon" href="ios/apple-icon-180.png" />
    <meta name="apple-touch-fullscreen" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="HBES 2027" />

    <style>
        .fav-btn {
            cursor: pointer;
            padding: 0;
            margin-left: 8px;
            border: none;
            background: none;
            color: #ffc107;
            /* Bootstrap warning color for yellow/gold */
        }

        body {
            padding-bottom: 70px;
            /* Prevent content from being covered by the menubar */
        }

        .nav-item_active {
            color: #ecb73c !important;
            /* Match your theme color */
        }

        /* Highlight for active bottom nav items */
        .nav-link-btn.active-nav {
            color: #ecb73c !important;
            /* Your theme's teal color */
            font-weight: bold;
            transform: scale(1.1);
            transition: all 0.2s ease-in-out;
        }

        .pseudo-btn::before {
            content: attr(data-time);
        }

        .accordion-item {
            scroll-margin-top: 240px;
            /* Adjust this value to give it a nice cushion at the top */
        }
    </style>
</head>

<body class="pb-70">
    <!-- Main Content View -->
    <div id="app-main-content" class="container-fluid">
        <!-- START OF STICKY HEADER CONTAINER -->
        <div class="sticky-top bg-white pt-3 pb-2 mb-3 border-bottom" style="top: 0; z-index: 1020">
            <h3 class="mb-3">HBES 2027</h3>
            <div class="mb-3">
                <div class="input-group">
                    <input type="text" id="search-input" class="form-control form-control-lg"
                        placeholder="Search talks by title or abstract..." autocomplete="off" />
                    <!-- FIXED: Removed inline onclick placeholder -->
                    <button class="btn btn-outline-secondary" type="button" id="clear-search">
                        <img src="./x.svg" alt="X" />
                    </button>
                </div>
                <div id="search-results" class="list-group mt-2" style="max-height: 300px; overflow-y: auto"></div>
            </div>
            <ul class="nav nav-pills mb-3" id="pills-tab" role="tablist">
                {% for item in d -%}
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="pills-{{item.day}}-tab" data-bs-toggle="pill"
                        data-bs-target="#pills-{{item.day}}" type="button" role="tab" aria-controls="pills-{{item.day}}"
                        aria-selected="true">
                        {{item.day}}
                    </button>
                </li>
                {% endfor -%}
                <li class="nav-item ms-auto" role="presentation">
                    <button class="nav-link" id="pills-authors-tab" data-bs-toggle="pill"
                        data-bs-target="#pills-authors" type="button" role="tab" aria-controls="pills-authors"
                        aria-selected="false">
                        <img src="./person.svg" alt="Person" />
                    </button>
                </li>
            </ul>
        </div>
        <!-- END OF STICKY HEADER CONTAINER -->

        <div class="tab-content" id="pills-tabContent">
            <!-- Schedule View -->
            {% for item in d -%}
            <div class="tab-pane fade show" id="pills-{{item.day}}" role="tabpanel"
                aria-labelledby="pills-{{item.day}}-tab" tabindex="0">
                <div class="accordion" id="accordion{{item.day}}">
                    {% for session in item.data -%}
                    <div class="accordion-item">
                        <h2 class="accordion-header d-flex justify-content-between align-items-center">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                data-bs-target="#collapse{{session.id}}" aria-expanded="false"
                                aria-controls="collapse{{session.id}}">
                                {{session.title}} <br />
                                {{session.time}}. {{session.location}}
                            </button>
                            <button type="button" class="fav-btn" data-type="session" data-id="{{session.id}}"
                                data-time="{{session.startdatetime}}" data-location="{{session.location}}"
                                title="Favorite">
                                <img src="./star.svg" alt="Favorite" />
                            </button>
                        </h2>
                        <div id="collapse{{session.id}}" class="accordion-collapse collapse"
                            data-bs-parent="#accordion{{item.day}}">
                            <div class="accordion-body">
                                {% for talk in session.talk -%}
                                <div class="d-flex align-items-center mb-2">
                                    <button type="button" class="btn btn-light text-start pseudo-btn"
                                        data-bs-toggle="modal" data-bs-target="#globalTalkModal"
                                        data-time="{{talk.start_time}}. " data-title="{{escape_html(talk.title)}}"
                                        data-abstract="{{escape_html(talk.abstract)}}"
                                        data-meta="{{talk.day}}, {{talk.start_time}}. {{talk.location}}"
                                        data-id="{{talk.id}}" data-location="{{talk.location}}"
                                        data-datetime="{{talk.startdatetime}}">
                                        {{talk.title}}
                                    </button>
                                    <button type="button" class="fav-btn" data-type="talk" data-id="{{talk.id}}"
                                        data-time="{{talk.startdatetime}}" data-location="{{talk.location}}"
                                        title="Favorite">
                                        <img src="./star.svg" alt="Favorite" />
                                    </button>
                                </div>
                                {% endfor -%}
                            </div>
                        </div>
                    </div>
                    {% endfor -%}
                </div>
            </div>
            {% endfor -%}

            <!-- Authors View -->
            <div class="tab-pane fade" id="pills-authors" role="tabpanel" aria-labelledby="pills-authors-tab"
                tabindex="0">
                <div class="accordion" id="accordion-authors">
                    <!-- Dynamic Loader Placeholder -->
                    <div class="text-center py-5" id="authors-tab-loader">
                        <div class="spinner-border text-warning" role="status">
                            <span class="visually-hidden">Loading authors...</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- View for Favorites -->
    <div id="app-favorites-view" style="display: none">
        <h3 class="mb-4" style="padding-left: 10px">Favorites</h3>
        <div id="favorites-list"></div>
    </div>

    <!-- Bottom Navigation Bar -->
    <nav class="fixed-bottom bg-white border-top shadow-sm" style="height: 60px">
        <div class="container d-flex justify-content-around align-items-center">
            <a href="#" id="btn-nav-schedule" class="text-decoration-none text-dark text-center nav-link-btn">
                <img src="./calendar3.svg" class="fs-4" alt="Calendar" />
                <div style="font-size: 10px">Schedule</div>
            </a>
            <a href="#" id="btn-nav-favorites" class="text-decoration-none text-muted text-center nav-link-btn">
                <img src="./star.svg" class="fs-4" alt="Star" />
                <div style="font-size: 10px">Favorites</div>
            </a>
        </div>
    </nav>

    <!-- Global Modals Container -->
    <div id="global-modals">
        <div class="modal fade" id="globalTalkModal" tabindex="-1" aria-labelledby="globalTalkModalLabel"
            aria-hidden="true">
            <div class="modal-dialog modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header d-flex justify-content-between align-items-center">
                        <span id="modal-talk-meta"></span>
                        <div class="d-flex align-items-center gap-3">
                            <button type="button" id="modal-fav-btn" class="fav-btn" data-type="talk" data-id=""
                                title="Favorite">
                                <img src="./star.svg" alt="Favorite" />
                            </button>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                    </div>
                    <div class="modal-body" id="modal-talk-abstract"></div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            Close
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="bootstrap.bundle.min.js"></script>

    <script>

        // Helper function to handle active state toggling
        function setActiveNav(btnId) {
            const scheduleBtn = document.getElementById("btn-nav-schedule");
            const favsBtn = document.getElementById("btn-nav-favorites");

            // Remove active class from both
            if (scheduleBtn) scheduleBtn.classList.remove("active-nav");
            if (favsBtn) favsBtn.classList.remove("active-nav");

            // Add active class to the clicked one
            const activeBtn = document.getElementById(btnId);
            if (activeBtn) activeBtn.classList.add("active-nav");
        }

        document.addEventListener("DOMContentLoaded", () => {
            const mainContent = document.getElementById("app-main-content");
            const favsZone = document.getElementById("app-favorites-view");

            // Initial render of favorite icons
            document.querySelectorAll(".fav-btn").forEach((btn) => {
                updateFavoriteIcons(btn.dataset.type, btn.dataset.id);
            });

            const searchInput = document.getElementById("search-input");
            const tabElements = document.querySelectorAll(
                'button[data-bs-toggle="pill"], a[data-bs-toggle="pill"]',
            );

            tabElements.forEach((tab) => {
                tab.addEventListener("shown.bs.tab", function (event) {
                    const activeTabId = event.target.id;

                    if (activeTabId === "pills-authors-tab") {
                        searchInput.placeholder = "Search authors...";
                        // NEW: Initialize author headers on demand
                        renderAuthorsSkeleton();
                    } else {
                        searchInput.placeholder =
                            "Search talks by title or abstract...";
                    }
                });
            });

            // Favorite button click logic
            // Favorite button click logic (FIXED: Uses Event Delegation)
            document.body.addEventListener("click", (e) => {
                // Find the closest favorite button element, even if an <img> inside it was clicked
                const btn = e.target.closest(".fav-btn");
                if (!btn) return;

                console.log("clicked dynamic button");
                const id = btn.dataset.id;
                const type = btn.dataset.type;
                const key = `${type}:${id}`;

                let labelText = "Favorite Item";
                if (btn.dataset.title) {
                    labelText = btn.dataset.title;
                } else if (btn.parentElement.querySelector("button")) {
                    labelText =
                        btn.parentElement.querySelector("button").innerText;
                } else if (btn.closest(".d-flex")) {
                    const otherBtn = btn
                        .closest(".d-flex")
                        .querySelector("button");
                    if (otherBtn) labelText = otherBtn.innerText;
                }
                labelText = labelText.split("\n")[0];

                if (favorites[key]) {
                    delete favorites[key];
                } else {
                    favorites[key] = {
                        title: labelText,
                        time: btn.dataset.time || "",
                        location: btn.dataset.location || "",
                        timestamp: new Date().toLocaleString(),
                    };
                }

                localStorage.setItem(
                    "conference_favorites",
                    JSON.stringify(favorites),
                );
                updateFavoriteIcons(type, id);

                // If the user is looking at the favorites tab and unfavorites an item,
                // refresh the list seamlessly so it disappears or updates in real time.
                const favsBtn =
                    document.getElementById("btn-nav-favorites");
                if (favsBtn && favsBtn.classList.contains("active-nav")) {
                    renderFavoritesList();
                }
            });

            // Navigation Listeners
            document
                .getElementById("btn-nav-schedule")
                .addEventListener("click", (e) => {
                    e.preventDefault();
                    if (mainContent) mainContent.style.display = "block";
                    if (favsZone) favsZone.style.display = "none";
                    setActiveNav("btn-nav-schedule");
                });

            document
                .getElementById("btn-nav-favorites")
                .addEventListener("click", (e) => {
                    e.preventDefault();
                    if (mainContent) mainContent.style.display = "none";
                    if (favsZone) favsZone.style.display = "block";
                    renderFavoritesList();
                    setActiveNav("btn-nav-favorites");
                });

            function renderFavoritesList() {
                const listContainer =
                    document.getElementById("favorites-list");
                if (!listContainer) return;

                const keys = Object.keys(favorites);
                if (keys.length === 0) {
                    listContainer.innerHTML =
                        '<p class="text-muted">No favorites yet.</p>';
                    return;
                }

                // Map to objects and Sort by Date (FIXED: Case-sensitivity capitalization match)
                let favItems = keys.map((key) => ({
                    key: key,
                    data: favorites[key],
                }));

                favItems.sort((a, b) => {
                    const dateA = new Date(a.data.time);
                    const dateB = new Date(b.data.time);
                    return dateA - dateB; // Sorts chronologically (earliest to latest)
                });

                listContainer.innerHTML = "";

                favItems.forEach((item) => {
                    const [type, id] = item.key.split(":");
                    const data = item.data;
                    const isFav = !!favorites[`${type}:${id}`];
                    const starImg = isFav
                        ? "./star-fill.svg"
                        : "./star.svg";

                    // 1. Create wrapper card structure
                    const cardElement = document.createElement("div");
                    cardElement.className = "card rounded-0 mb-0";

                    let content = "";
                    let formattedTime = "";

                    if (data.time) {
                        const dateObj = new Date(data.time);
                        formattedTime =
                            dateObj.toLocaleDateString("en-US", {
                                weekday: "long",
                                month: "short",
                                day: "numeric",
                            }) +
                            " - " +
                            dateObj.toLocaleTimeString("en-US", {
                                hour: "2-digit",
                                minute: "2-digit",
                            });
                    }

                    // Left Column Text
                    let modalAttributes = type === "talk" ? `role="button" tabindex="0" data-bs-toggle="modal" data-bs-target="#globalTalkModal" data-id="${id}"` : "";
                    content += `<div class="flex-grow-1 text-start" ${modalAttributes}>`;
                    content += `  <h6 class="${type === "talk" ? "mb-1 text-primary" : "mb-1 text-success"}">${data.title}</h6>`;

                    if (data.time) {
                        content += `  <p class="mb-0 small text-muted"><img src="./calendar.svg" alt="Calendar" /> ${formattedTime}</p>`;
                    }
                    if (data.location) {
                        content += `  <p class="mb-0 small text-muted"><img src="./geo-alt.svg" alt="Location" /> ${data.location}</p>`;
                    }
                    content += `</div>`;

                    // Right Column Button (FIXED: Flexbox layout keeps button perfectly right-aligned)
                    content += `<div>`;
                    content += `  <button type="button" class="fav-btn btn btn-link p-0 ms-3"
                                    data-type="${type}"
                                    data-id="${id}"
                                    data-time="${data.time || ""}"
                                    data-location="${data.location || ""}"
                                    data-title="${data.title || ""}"
                                    title="Favorite">
                                    <img src="${starImg}" alt="Favorite" />
                                  </button>`;
                    content += `</div>`;

                    // 2. Put layout inside card-body
                    const cardBody = document.createElement("div");
                    cardBody.className =
                        "card-body d-flex justify-content-between align-items-center";

                    cardBody.innerHTML = content;
                    cardElement.appendChild(cardBody);
                    listContainer.appendChild(cardElement);
                });
            }

            // Set initial state on page load
            window.addEventListener("DOMContentLoaded", () => {
                document
                    .getElementById("btn-nav-schedule")
                    .classList.add("active-nav");
            });
        });

        // --- Search Functionality ---
        const searchInput = document.getElementById("search-input");
        const searchResults = document.getElementById("search-results");
        let talkIndex = {{ talks }};
        let authorIndex = {{ authors }};

        // --- High-Performance On-Demand Rendering Engine ---
        let authorsRendered = false;

        function renderAuthorsSkeleton() {
            // Prevent reconstructing the DOM if it's already generated
            if (authorsRendered) return;
            const container = document.getElementById("accordion-authors");
            if (!container) return;

            const fragment = document.createDocumentFragment();

            authorIndex.forEach((author) => {
                const item = document.createElement("div");
                item.className = "accordion-item";
                item.setAttribute("id", `author-row-${author.author_id}`);
                item.setAttribute("data-id", author.author_id);
                item.setAttribute("data-name", author.name);

                item.innerHTML = `
                    <h2 class="accordion-header d-flex justify-content-between align-items-center">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                            data-bs-target="#collapse${author.author_id}" aria-expanded="false"
                            aria-controls="collapse${author.author_id}" data-author-id="${author.author_id}">
                            <div class="text-start">
                                <strong>${author.name}</strong><br />
                                <small class="text-muted fw-normal">${author.affiliation || ''}</small>
                            </div>
                        </button>
                    </h2>
                    <div id="collapse${author.author_id}" class="accordion-collapse collapse"
                        data-bs-parent="#accordion-authors">
                        <div class="accordion-body" id="author-body-${author.author_id}">
                            <div class="text-center py-2">
                                <div class="spinner-border spinner-border-sm text-muted" role="status"></div>
                            </div>
                        </div>
                    </div>
                `;
                fragment.appendChild(item);
            });

            // Wipe out the loading spinner and append the optimized structure in a single layout pass
            container.innerHTML = "";
            container.appendChild(fragment);
            authorsRendered = true;
        }

        // Lazy-load inner data only when an accordion item expands
        document.getElementById("accordion-authors").addEventListener("show.bs.collapse", (e) => {
            const button = e.target.previousElementSibling?.querySelector(".accordion-button");
            if (!button) return;

            const authorId = button.getAttribute("data-author-id");
            const bodyZone = document.getElementById(`author-body-${authorId}`);

            // Only generate inner HTML if the spinner placeholder is still visible
            if (bodyZone && bodyZone.querySelector(".spinner-border")) {
                const author = authorIndex.find(a => a.author_id == authorId);
                if (!author || !author.data || author.data.length === 0) {
                    bodyZone.innerHTML = '<p class="text-muted small mb-0">No sessions listed.</p>';
                    return;
                }

                let html = "";
                author.data.forEach((talk) => {
                    html += `
                        <div class="d-flex align-items-center mb-2">
                            <button type="button" class="btn btn-light text-start author-talk-btn"
                                data-bs-toggle="modal" data-bs-target="#globalTalkModal" data-id="${talk.id}">
                                ${talk.daytimelocation}. <strong>${talk.title}</strong>
                            </button>
                            <button type="button" class="fav-btn" data-type="talk" data-id="${talk.id}" title="Favorite">
                                <img src="./star.svg" alt="Favorite" />
                            </button>
                        </div>
                    `;
                });

                bodyZone.innerHTML = html;

                // Dynamically sync favorite filled/empty star icon states
                author.data.forEach((talk) => {
                    updateFavoriteIcons("talk", talk.id);
                });
            }
        });

        const favorites = JSON.parse(
            localStorage.getItem("conference_favorites") || "{}",
        );

        function updateFavoriteIcons(type, id) {
            const key = `${type}:${id}`;
            const isFav = !!favorites[key];
            const buttons = document.querySelectorAll(
                `.fav-btn[data-type="${type}"][data-id="${id}"]`,
            );
            buttons.forEach((btn) => {
                const img = btn.querySelector("img");
                if (isFav) {
                    img.src = "./star-fill.svg";
                } else {
                    img.src = "./star.svg";
                }
            });
        }

        document.addEventListener("DOMContentLoaded", () => {
            // Keep your existing favorites setup and navigation code...

            // 2. Dynamic Modal Population Listener
            const globalModal = document.getElementById('globalTalkModal');
            if (globalModal) {
                globalModal.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    // Fallback to a modal dataset attribute if triggered directly from a search match
                    const id = button ? button.getAttribute('data-id') : globalModal.dataset.activeTalkId;

                    const talkData = talkIndex.find(t => t.id == id);
                    const metaNode = document.getElementById('modal-talk-meta');
                    const abstractNode = document.getElementById('modal-talk-abstract');
                    const modalFavBtn = document.getElementById('modal-fav-btn');

                    if (talkData) {
                        // 2. Populate from the dictionary index
                        metaNode.textContent = `${talkData.day || ''}, ${talkData.start_time || ''}. ${talkData.location || ''}`;
                        abstractNode.innerHTML = talkData.abstract || "<p>Abstract not provided.</p>";

                        // Sync the action button
                        modalFavBtn.setAttribute('data-id', talkData.id);
                        modalFavBtn.setAttribute('data-title', talkData.title);
                        modalFavBtn.setAttribute('data-time', talkData.startdatetime || '');
                        modalFavBtn.setAttribute('data-location', talkData.location || '');
                    } else {
                        // 3. Graceful fallback for Schedule View buttons that still use data-* attributes
                        metaNode.textContent = button.getAttribute('data-meta') || "";
                        abstractNode.innerHTML = button.getAttribute('data-abstract') || "<p>Abstract not found.</p>";

                        modalFavBtn.setAttribute('data-id', id);
                        modalFavBtn.setAttribute('data-title', button.getAttribute('data-title') || "");
                        modalFavBtn.setAttribute('data-time', button.getAttribute('data-time') || button.getAttribute('data-datetime') || "");
                        modalFavBtn.setAttribute('data-location', button.getAttribute('data-location') || "");
                    }

                    // 4. Update the visual filled/empty star state
                    updateFavoriteIcons('talk', id);
                });
            }

            // 3. Cleaned-Up Search Execution
            const searchInput = document.getElementById("search-input");
            const searchResults = document.getElementById("search-results");

            searchInput.addEventListener("input", (e) => {
                const query = e.target.value.toLowerCase().trim();
                searchResults.innerHTML = "";

                if (query.length < 2) return;

                const isAuthorsView = document.getElementById("pills-authors")?.classList.contains("active");
                let results = [];

                if (isAuthorsView) {
                    // Safe check for author names
                    results = authorIndex.filter(author =>
                        author.name && author.name.toLowerCase().includes(query)
                    );
                } else {
                    // FIX: Added abstract search & safe string conversions to prevent integer method crashes
                    results = talkIndex.filter(talk =>
                        (talk.title && talk.title.toLowerCase().includes(query)) ||
                        (talk.abstract && talk.abstract.toLowerCase().includes(query)) ||
                        (talk.id && talk.id.toString().toLowerCase().includes(query))
                    );
                }

                results.forEach((item) => {
                    const resultItem = document.createElement("button");
                    resultItem.className = "list-group-item list-group-item-action d-flex justify-content-between align-items-center";

                    // Ensure authors use author_id and talks use standard id
                    resultItem.dataset.targetId = item.author_id || item.id;
                    resultItem.dataset.isAuthor = isAuthorsView ? "true" : "false";

                    if (isAuthorsView) {
                        resultItem.innerHTML = `<span class="text-start">${item.name}</span>`;
                    } else {
                        resultItem.innerHTML = `<span class="text-start">${item.title}</span>`;
                    }
                    searchResults.appendChild(resultItem);
                });
            });

            // 4. Handle Search Result Selection (Fixed to match our new global modal framework)
            if (searchResults) {
                searchResults.addEventListener("click", (e) => {
                    const btn = e.target.closest("button");
                    if (!btn || !searchResults.contains(btn)) return;

                    const targetId = btn.dataset.targetId;
                    const isAuthor = btn.dataset.isAuthor === "true";

                    if (isAuthor) {
                        const element = document.getElementById(`collapse${targetId}`);
                        if (element) {
                            bootstrap.Collapse.getOrCreateInstance(element, { toggle: false }).show();
                            setTimeout(() => {
                                // Target the parent accordion item so the header stays visible!
                                const accordionItem = element.closest('.accordion-item');
                                if (accordionItem) {
                                    accordionItem.scrollIntoView({ behavior: "smooth", block: "start" });
                                }
                            }, 300);
                        }
                    } else {
                        // Attempt to locate a matching button in the active schedule DOM view
                        const originalBtn = document.querySelector(`button[data-id="${targetId}"][data-bs-target="#globalTalkModal"]`);
                        const modalInstance = bootstrap.Modal.getOrCreateInstance(globalModal);

                        if (originalBtn) {
                            modalInstance.show(originalBtn);
                        } else {
                            // Safe fallback: Launch the modal directly using the JSON index reference
                            globalModal.dataset.activeTalkId = targetId;
                            modalInstance.show();
                        }
                    }
                });
            }
            // Handle Search Clearing
            const clearSearchBtn = document.getElementById("clear-search");
            if (clearSearchBtn) {
                clearSearchBtn.addEventListener("click", () => {
                    const input = document.getElementById("search-input");
                    const results = document.getElementById("search-results");

                    if (input) {
                        input.value = "";
                        // Dispatches an input event so the list filters back to empty automatically
                        input.dispatchEvent(new Event("input"));
                    }
                    if (results) {
                        results.innerHTML = "";
                    }
                });
            }
        });

        // Close results when clicking outside (optional but recommended)
        // document.addEventListener("click", (e) => {
